            "state": "translated",
            "value": "ここでは http と https のページだけを開けます。"
          }
        }
      }
    },
    "browserStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page or selected movie changed. Import the current page again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面或所选影片已改变，请重新导入当前页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面或所選影片已改變，請重新匯入目前頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページまたは選択した作品が変わりました。現在のページをもう一度読み込んでください。"
          }
        }
      }
    },
    "browserTooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page exceeds the 2 MiB import limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面超过 2 MiB 导入限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面超過 2 MiB 匯入限制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは読み込み上限の 2 MiB を超えています。"
          }
        }
      }
    },
    "browserCaptureFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page could not be read. Finish any site verification or reload it, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取页面。请完成网站验证或刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取頁面。請完成網站驗證或重新載入後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを読み取れませんでした。サイトの認証を完了するか、ページを再読み込みしてから再試行してください。"
          }
        }
      }
    },
