    "safeStopMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app open while a save finishes or safely rolls back. You may request cancellation and close after it stops."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持应用打开，等待保存完成或安全恢复。可以请求取消，待操作停止后再关闭。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存の完了、または安全な復元が終わるまでアプリを開いたままにしてください。キャンセルを要求し、処理が停止してから閉じることもできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 App 開啟，等待儲存完成或安全復原。可以要求取消，待操作停止後再關閉。"
          }
        }
      }
    },
    "keepOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Open"
          }
        },
        "zh-Hans": {
