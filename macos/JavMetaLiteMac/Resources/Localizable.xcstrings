    "queueSearchHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search movie IDs, current titles (including unsaved edits), or original filenames. Search does not change checkmarks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索番号、当前标题（含未保存编辑）或原文件名。搜索不改变勾选。"
          }
        },
        "zh-Hant": {
