            "value": "%@ に読み込めます。保存前に読み込んだ項目を確認してください。"
          }
        }
      }
    },
    "browserPrivate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This private browser does not read other browsers’ cookies. Page content is collected only when you choose Import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此独立浏览器不会读取其他浏览器的 Cookie；仅在点击导入时采集页面内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此獨立瀏覽器不會讀取其他瀏覽器的 Cookie；僅在按下匯入時擷取頁面內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この専用ブラウザーは他のブラウザーの Cookie を読み取りません。ページの内容は「読み込む」を選んだときだけ取得します。"
          }
        }
      }
    },
    "browserSchemeBlocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only http and https pages may open here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
