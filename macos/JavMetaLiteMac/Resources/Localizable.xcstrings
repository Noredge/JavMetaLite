        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本支持原位置保存 NFO，图片输出和视频整理尚未启用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは元の場所に NFO を保存できます。画像出力と動画の整理はまだ利用できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本支援原位置儲存 NFO，圖片輸出和影片整理尚未啟用。"
