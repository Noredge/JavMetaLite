    "privacyMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No telemetry. Queries run only when requested. Queue and edit drafts stay in the current app session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无遥测，仅在主动查询时联网。队列和编辑草稿仅保留在本次应用会话中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テレメトリはありません。検索は操作したときだけ実行します。キューと編集中の内容は現在のアプリのセッション内に保持されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無遙測，僅在主動查詢時連線。佇列和編輯草稿僅保留在本次App 工作階段中。"
          }
        }
      }
    },
