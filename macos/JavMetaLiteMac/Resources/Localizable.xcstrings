    "reviewReferenceUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until the engine is idle and its status is confirmed before exporting this review reference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待引擎空闲并核实操作状态后，再导出审核参考。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待引擎閒置並核實操作狀態後，再匯出審核參考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンが待機状態になり、操作状態を確認してから下書きを書き出してください。"
          }
        }
      }
    },
    "reviewReferenceInstructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This JSON preserves current review values and unsent drafts for manual reference. It cannot be imported or used to run a save. After reimporting movies, compare the fresh disk contents before manually reapplying edits. Keep this file until those edits are saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 保留当前审核值与未提交草稿，供人工参考，不能导入或执行保存。重新导入影片后，请对照最新磁盘内容，再手动补回需要的编辑；在这些编辑保存前保留此文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 JSON 保留目前審核值與未提交草稿，供人工參考，不能匯入或執行儲存。重新匯入影片後，請對照最新磁碟內容，再手動補回需要的編輯；在這些編輯儲存前保留此檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この JSON は現在の確認値と未送信の下書きを手動確認用に保存します。読み込みや保存処理の実行には使えません。動画を再取り込みした後、新しいディスク内容と照合して必要な編集を手動で戻してください。その編集を保存するまで、このファイルを保管してください。"
          }
        }
      }
    },
    "recoveryStatusRefreshed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine is idle and the record list has been refreshed. No operation was replayed. Inspect the remaining records and reimport movies whose disk baseline is blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎已空闲，记录列表已刷新；未重放任何操作。请检查剩余记录，并重新导入磁盘基线被阻止的影片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎已閒置，記錄清單已重新整理；未重播任何操作。請檢查剩餘記錄，並重新匯入磁碟基線被阻止的影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンは待機中で、記録一覧を更新しました。操作は再実行していません。残った記録を確認し、ディスク状態が未確認の動画を再取り込みしてください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
