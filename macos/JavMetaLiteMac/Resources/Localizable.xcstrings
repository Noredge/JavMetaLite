    "error.RECOVERY_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the transaction records and select one again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请刷新事务记录后重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新整理交易記錄後重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理記録を更新して再選択してください。"
          }
        }
      }
    },
    "error.RECOVERY_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery record or files changed. Verify again before archiving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录或文件已变化，归档前请重新核验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原記錄或檔案已變更，封存前請重新核驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧記録またはファイルが変更されました。保管前に再確認してください。"
          }
        }
      }
    },
    "error.RECOVERY_ARCHIVE_CONFLICT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived record already occupies this path. Inspect both records first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档位置已有记录，请先检查两份记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存位置已有記錄，請先檢查兩份記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管先に記録が既に存在します。両方を確認してください。"
          }
        }
      }
    },
    "error.CONFIRMATION_REQUIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and explicitly confirm the verified file outcome first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先审阅并明确确认核验结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先審閱並明確確認核驗結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認結果を確認し、明示的に承認してください。"
          }
        }
      }
    },
    "exportReviewReference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Review Drafts…"
          }
        },
        "zh-Hans": {
