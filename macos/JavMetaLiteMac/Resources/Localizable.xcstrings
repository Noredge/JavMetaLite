    "unsavedMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d movies have unsaved changes. Review them before quitting, or explicitly discard these edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 部影片有未保存修改。退出前可查看这些项目，或明确放弃编辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 作品に未保存の変更があります。終了前に確認するか、編集内容を破棄してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 部影片有未儲存修改。結束前可查看這些項目，或明確放棄編輯。"
          }
        }
      }
    },
