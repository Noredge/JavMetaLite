    "operationReceiptUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earlier operation receipt is unavailable. The queue has been refreshed. Check the results and recovery records; nothing will be retried automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧操作回执已不可用，已刷新队列。请核对结果和恢复记录；不会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的操作回執已無法使用，已重新整理佇列。請核對結果與復原記錄；不會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の操作結果を取得できないため、キューを更新しました。実際の結果と復旧記録を確認してください。自動で再試行することはありません。"
          }
        }
      }
