    "artworkSourceSelectionNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing a source also selects its sample images and clears samples from other sources. All images only changes the display."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择来源会同时选中该来源的样张，并清除其他来源样张的勾选。“全部图片”只改变显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇來源會同時選取該來源的樣張，並清除其他來源樣張的勾選。「全部圖片」只改變顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得元を選ぶと、その取得元のスチル画像を選択し、他の取得元の選択を解除します。「すべての画像」は表示のみを変更します。"
          }
        }
      }
    },
    "saveWithoutLoadedPreviews": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some previews have not been loaded. Saving uses the reviewed image sources and does not require opening each preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分预览尚未加载。保存使用已审核的图片来源，无需逐张打开预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分預覽尚未載入。儲存使用已審核的圖片來源，無需逐張開啟預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読み込みのプレビューがあります。保存には確認済みの画像取得元を使うため、各プレビューを開く必要はありません。"
          }
        }
      }
    },
    "error.PROVIDER_TIMEOUT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source timed out. Existing metadata is preserved; retry this source when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源响应超时。已取得的资料会保留，可稍后重试此来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源回應逾時。已取得的資料會保留，可稍後重試此來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得元がタイムアウトしました。取得済みの情報は保持されます。後でこの取得元を再試行してください。"
          }
        }
      }
    },
    "error.PROVIDER_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source returned no matching movie. Existing metadata is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此来源未找到匹配影片。已取得的资料会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此來源未找到相符影片。已取得的資料會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取得元には一致する作品がありません。取得済みの情報は保持されます。"
          }
        }
      }
    },
    "error.PROVIDER_HTTP_ERROR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source request failed. Check the connection and retry this source; existing metadata is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源请求失败。请检查网络后重试此来源；已取得的资料会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源請求失敗。請檢查網路後重試此來源；已取得的資料會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得元へのリクエストに失敗しました。接続を確認してこの取得元を再試行してください。取得済みの情報は保持されます。"
          }
        }
      }
    },
    "error.PROVIDER_FAILED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source could not be read. Review the details before retrying; existing metadata is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此来源。请查看详情后重试；已取得的资料会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此來源。請查看詳細資訊後重試；已取得的資料會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取得元を読み取れませんでした。詳細を確認してから再試行してください。取得済みの情報は保持されます。"
          }
        }
      }
    },
