    "discoveryExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scan can no longer be confirmed. Scan again to review the current files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此扫描结果已无法确认，请重新扫描并核对当前文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此掃描結果已無法確認，請重新掃描並核對目前的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャン結果は使用できません。再スキャンして現在のファイルを確認してください。"
          }
        }
      }
    },
    "error.DISCOVERY_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan expired or was already used. Scan again before adding movies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描结果已过期或使用过，请重新扫描后加入影片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描結果已過期或使用過，請重新掃描後加入影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン結果が期限切れか、すでに使用されています。再スキャンしてから動画を追加してください。"
          }
        }
      }
    },
    "error.DISCOVERY_CAPACITY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many scans are pending, or this scan is too large. Cancel an earlier scan or select fewer files and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待确认的扫描结果过多，或本次扫描超出容量。请取消已有扫描，或减少文件后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待確認的掃描結果過多，或本次掃描超出容量。請取消已有掃描，或減少檔案後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のスキャンが多すぎるか、スキャンの容量が上限を超えています。以前のスキャンを取り消すか、ファイルを減らして再試行してください。"
          }
        }
      }
    },
