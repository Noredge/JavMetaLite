    },
    "conflict.sidecarConsent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan does not authorize replacing existing NFO and artwork. Generate a new preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此计划未授权替换已有 NFO 和图片，请重新生成预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此計畫未授權替換現有 NFO 和圖片，請重新產生預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計画では既存の NFO と画像の置換が許可されていません。プレビューを再作成してください。"
          }
        }
      }
    },
    "reviewSaveConsent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Save applies the changes below, including replacement of listed NFO and artwork files. Videos are never overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认保存即应用下列变更，包括替换列出的已有 NFO 和图片；视频不会被覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認儲存即套用下列變更，包括替換列出的現有 NFO 和圖片；影片不會被覆寫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を確定すると、一覧にある既存の NFO と画像の置換を含む変更を適用します。動画は上書きしません。"
          }
        }
      }
    },
    "preferencesSavedAutomatically": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings are remembered automatically for the next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会自动记住，下次打开时恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定會自動記住，下次開啟時還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は自動的に記憶され、次回起動時に復元されます。"
          }
        }
      }
    },
    "engineExited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The metadata engine has exited"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料引擎已退出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料引擎已結束"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータエンジンが終了しました"
          }
        }
      }
    },
    "engineExitedEndMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine process has ended. Save results remain unknown. Export the last reviewed metadata and unsent drafts before ending this session. Reopen the app to inspect recovery and reread files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎进程已结束，保存结果仍未确认。请先导出最后收到的审核资料与未提交草稿，再结束会话。重新打开后应检查恢复记录并重新读取文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎程序已結束，儲存結果仍未確認。請先匯出最後收到的審核資料與未送出草稿，再結束工作階段。重新開啟後應檢查復原紀錄並重新讀取檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンのプロセスは終了しました。保存結果は未確認です。最後に受信した確認内容と未送信の下書きを書き出してから終了してください。再起動後に復旧記録と元のファイルを確認してください。"
          }
        }
      }
    },
    "exportReviewRecovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Review…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出审核草稿…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出審核草稿…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認内容を書き出す…"
          }
        }
      }
    },
    "recoveryExportMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports a JSON reference containing local paths, reviewed metadata and unsent drafts. It does not write movie files or confirm a save result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出含本机路径、审核资料与未提交草稿的 JSON 参考文件；不会写入影片文件，也不代表保存结果已确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出含本機路徑、審核資料與未送出草稿的 JSON 參考檔；不會寫入影片檔案，也不代表儲存結果已確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルパス、確認済みメタデータ、未送信の下書きを JSON に書き出します。動画ファイルの変更や保存結果の確定は行いません。"
          }
        }
      }
    },
