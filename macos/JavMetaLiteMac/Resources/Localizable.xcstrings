    "endWithoutExportMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexported review changes and drafts will be lost when the app quits. Save results remain unknown; existing transaction recovery files will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后，未导出的审核修改和草稿将丢失。保存结果仍未确认，已有事务恢复文件会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束後，未匯出的審核修改和草稿將遺失。儲存結果仍未確認，既有交易復原檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了すると、書き出していない確認内容と下書きが失われます。保存結果は未確認のままで、既存のトランザクション復旧ファイルは保持されます。"
          }
