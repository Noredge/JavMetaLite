    "closeWindowMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this window keeps drafts in this app session. Reopen it from the Dock to continue. Quitting will ask before discarding edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后，草稿保留在本次应用会话中，可从 Dock 重新打开。退出应用前会询问是否放弃编辑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じても、このアプリのセッション中は編集内容が保持されます。Dock から再度開いて続行できます。アプリを終了する際は、編集内容を破棄するか確認します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗後，草稿會保留在本次 App 工作階段中，可從 Dock 重新開啟。結束 App 前會詢問是否放棄編輯。"
          }
        }
      }
    },
