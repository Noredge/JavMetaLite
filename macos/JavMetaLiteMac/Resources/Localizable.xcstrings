    "rawValuesNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates, ratings, and runtimes keep their original text. Empty values are explicit edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、评分与时长保留原始文本。清空字段会作为明确编辑提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、評価、収録時間は元のテキストを保持します。空欄にすると、値を消す編集として適用されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、評分與時長會保留原始文字。清空欄位會作為明確的編輯提交。"
          }
        }
      }
    },
