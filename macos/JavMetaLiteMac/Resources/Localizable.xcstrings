    "verifiedCopyNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video transfers use a full SHA-256 verified copy. Sources are removed only after a successful commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频位移采用完整 SHA-256 校验复制，仅在成功提交后移除来源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の転送では全体の SHA-256 を照合してコピーを検証します。変更が正常に確定してから元ファイルを削除します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
