    "clearQueueMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %d movies from this queue? %d have unsaved edits. This clears only this session; no videos, images or saved NFO files are deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从当前队列移除 %d 部影片，其中 %d 部有未保存编辑。仅清空本次队列，不删除视频、图片或已保存的 NFO。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從目前佇列移除 %d 部影片，其中 %d 部有未儲存編輯。只清空本次佇列，不刪除影片、圖片或已儲存的 NFO。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューから %d 件を取り除きます。%d 件に未保存の編集があります。このセッションだけを空にし、動画・画像・保存済みNFOは削除しません。"
