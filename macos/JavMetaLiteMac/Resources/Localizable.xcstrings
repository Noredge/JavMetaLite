    "queueSelectionHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a movie to view or edit. Checkboxes choose query and save targets. Space toggles the viewed movie’s check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击影片行查看、编辑；勾选决定查询和保存范围。空格切换当前影片勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊影片列檢視、編輯；勾選決定查詢和儲存範圍。空格切換目前影片勾選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のクリックで表示・編集し、チェックで検索・保存の対象を指定します。スペースで現在の作品のチェックを切り替えます。"
          }
        }
      }
    },
