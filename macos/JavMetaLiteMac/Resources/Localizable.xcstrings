    "recoveryArchiveConfirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed the verified file outcome. Move this journal into the archive and clear its recovery warning. Media will remain unchanged. Reimport affected movies before saving again; unsent drafts are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已审阅核验结果。同意将本日志移入归档并解除它的恢复提示。媒体文件不会改变。再次保存前需重新导入相关影片；未提交草稿仍保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已審閱核驗結果。同意將本日誌移入封存並解除它的復原提示。媒體檔案不會變更。再次儲存前需重新匯入相關影片；未提交草稿仍保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認結果を確認しました。記録を保管先へ移動し、この復旧警告を解除します。メディアは変更しません。再保存の前に関連する動画を再読み込みしてください。未送信の下書きは保持されます。"
          }
        }
      }
    },
    "recoveryArchivedReimport": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record archived; no media changed. Export any review drafts you need before removing and reimporting the affected movies. Other folders remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已归档，媒体未改变。请先导出需要保留的审核草稿，再移除并重新导入相关影片；其他文件夹中的影片不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄已歸檔，媒體未改變。請先匯出需要保留的審核草稿，再移除並重新匯入相關影片；其他資料夾中的影片不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録をアーカイブしました。メディアは変更していません。必要な下書きを書き出してから、対象の動画を一覧から削除して再取り込みしてください。別フォルダーの動画はそのまま使えます。"
          }
        }
      }
    },
    "recoveryRefreshFirst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the recovery list before selecting this record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先刷新恢复列表，再选择该记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先重新整理復原清單，再選擇該記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧一覧を更新してから記録を選択してください。"
          }
        }
      }
    },
    "recoveryConfirmRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A successful file verification and your explicit confirmation are required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先成功核验文件并明确确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先成功核驗檔案並明確確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの確認と明示的な承認が必要です。"
          }
        }
      }
    },
    "recoveryArchiveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiving was not confirmed. Refresh the records before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档结果未确认，请刷新记录后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存結果未確認，請重新整理記錄後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管結果を確認できません。一覧を更新してください。"
          }
        }
      }
    },
    "recovery.issue.legacyRecord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older journal has no verifiable before/after hashes. It remains read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旧日志没有可验证的前后状态哈希，仅供只读审查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此舊日誌沒有可驗證的前後狀態雜湊，僅供唯讀審查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧記録には確認できる前後のハッシュがありません。読み取り専用で保持します。"
          }
        }
      }
    },
    "recovery.issue.unreadableRecord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record is missing, unreadable, linked, malformed or too large. Preserve it for manual inspection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录缺失、不可读、被链接替换、格式异常或过大，请保留供人工检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄缺失、無法讀取、被連結取代、格式異常或過大，請保留供人工檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が欠落、読取不能、リンク、形式不正、または大きすぎます。手動調査のため保持してください。"
          }
        }
      }
    },
    "recovery.issue.invalidRecord": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required recovery evidence is incomplete or invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必需的恢复证据不完整或无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必要的復原證據不完整或無效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な復旧情報が不完全または無効です。"
          }
        }
      }
    },
    "recovery.issue.ownerActiveOrUnverifiable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The owning engine is still running, or its ownership cannot be verified. Close that app safely and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所属引擎仍在运行，或无法核实其所有权。请安全关闭对应应用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所屬引擎仍在執行，或無法核實其所有權。請安全關閉對應應用程式後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有元のエンジンが実行中、または所有状態を確認できません。対応するアプリを安全に終了して再試行してください。"
          }
        }
      }
    },
    "recovery.issue.fileUnverifiable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file could not be verified safely. Check permissions and linked paths."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有文件无法安全核验，请检查权限和链接路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有檔案無法安全核驗，請檢查權限和連結路徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に確認できないファイルがあります。権限とリンクを確認してください。"
          }
        }
      }
    },
    "recovery.issue.temporaryRemains": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary or backup paths still exist. Inspect and resolve them before rechecking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有临时或备份路径，请检查并处理后重新核验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有暫存或備份路徑，請檢查並處理後重新核驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ファイルまたはバックアップが残っています。確認と処理の後に再確認してください。"
          }
        }
      }
    },
    "recovery.issue.temporaryUnverifiable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary path could not be verified safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时路径无法安全核验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存路徑無法安全核驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時パスを安全に確認できません。"
          }
        }
      }
    },
    "recovery.issue.unknownOutcome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal outcome is unknown. No archive permission was granted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志结果未知，未授予归档许可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌結果未知，未授予封存許可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録の結果は不明です。保管は許可されませんでした。"
          }
        }
      }
    },
    "recovery.issue.filesDoNotMatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files match neither the recorded original state nor a recorded successful commit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件既不匹配原始状态，也不匹配已记录的成功提交状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案既不符合原始狀態，也不符合已記錄的成功提交狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは元の状態にも、記録された確定後の状態にも一致しません。"
          }
        }
      }
    },
    "recovery.issue.recordChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal changed during verification. Refresh and verify again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核验期间日志发生变化，请刷新后重新核验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核驗期間日誌發生變更，請重新整理後再次核驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中に記録が変更されました。更新して再確認してください。"
          }
        }
      }
    },
    "recovery.issue.filesChangedDuringVerification": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file changed during verification. Verify again after file activity stops."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核验期间文件发生变化，请停止相关文件操作后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核驗期間檔案發生變更，請停止相關檔案操作後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中にファイルが変更されました。ファイル操作の終了後に再確認してください。"
          }
        }
      }
    },
    "recovery.file.present": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Present; SHA-256 checked"
          }
