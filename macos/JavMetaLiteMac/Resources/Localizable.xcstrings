    "skipSavePreviewHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves directly after checking the plan, including replacing existing NFO and artwork. Conflicts still stop the save; videos are never overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查计划后直接保存，包括替换已有 NFO 和图片。冲突仍会阻止保存，不覆盖视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查計畫後直接儲存，包括替換現有 NFO 和圖片。衝突仍會阻止儲存，不覆寫影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
