          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 枚の画像をゴミ箱に移動しました。"
          }
        }
      }
    },
    "trashFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images could not be moved to Trash. The remaining originals were kept."
          }
        },
        "zh-Hans": {
