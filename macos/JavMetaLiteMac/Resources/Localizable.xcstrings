    "trashTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move these images to Trash?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这些图片移到废纸篓？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這些圖片移到垃圾桶？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの画像をゴミ箱に入れますか？"
          }
        }
      }
    },
    "trashExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These exact files will be moved to the macOS Trash. This is separate from the NFO save transaction. A failure keeps the original file; permanent deletion is never used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下列实际文件将移到 macOS 废纸篓。此操作独立于 NFO 保存事务；失败时保留原文件，绝不改为永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下列實際檔案將移到 macOS 垃圾桶。此操作獨立於 NFO 儲存交易；失敗時保留原檔案，絕不改為永久刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下に示すファイルを macOS のゴミ箱に移動します。この操作は NFO の保存処理とは別です。失敗した場合は元のファイルを保持し、完全削除には切り替えません。"
          }
        }
      }
    },
    "trashConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れる"
          }
        }
      }
    },
    "trashCompleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %d images to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %d 张图片移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
