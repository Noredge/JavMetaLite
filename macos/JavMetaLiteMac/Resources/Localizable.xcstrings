    "error.ARTWORK_INVALID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image cannot be read safely or exceeds the image limits. Choose another image or reimport the movie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片无法安全读取或超过图片限制，请选择其他图片或重新导入影片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片無法安全讀取或超過圖片限制，請選擇其他圖片或重新匯入影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は安全に読み取れないか、画像の上限を超えています。別の画像を選ぶか、作品を読み込み直してください。"
          }
        }
      }
    },
    "error.ARTWORK_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is no longer available in the movie. Refresh the movie before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片已不在影片中，请刷新影片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片已不在影片中，請重新整理影片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作品で画像を利用できなくなりました。作品を更新してから再試行してください。"
          }
        }
      }
    },
    "error.ARTWORK_NOT_LOCAL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this movie’s registered local images can be moved to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此影片已识别的本地图片可以移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此影片已識別的本地圖片可以移到垃圾桶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動できるのは、この作品で認識されているローカル画像だけです。"
          }
        }
      }
    },
    "error.CANCELED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was canceled safely. Review its results before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已安全取消，请检查结果后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已安全取消，請檢查結果後再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理を安全にキャンセルしました。結果を確認してから続行してください。"
          }
        }
      }
    },
    "error.EDIT_TOO_LARGE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edit exceeds the supported size. Shorten the submitted text and try again; existing values were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次编辑超过支持的大小，请缩短文本后重试；原有资料已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次編輯超過支援的大小，請縮短文字後重試；原有資料已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集内容が対応するサイズを超えています。テキストを短くして再試行してください。既存の値は保持されています。"
          }
        }
      }
    },
    "error.INVALID_PARAMS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested options are invalid. Check the current selection and settings before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求选项无效，请检查当前选择和设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求的選項無效，請檢查目前選取項目與設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したオプションが無効です。現在の選択と設定を確認してから再試行してください。"
          }
        }
      }
    },
    "error.INVALID_PARTS": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least two single-file movies with the same ID and source folder, then confirm their order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择至少两个同番号、同源文件夹的单文件影片，并确认分段顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇至少兩個相同番號、相同來源資料夾的單檔案影片，並確認分段順序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ品番で同じ元フォルダーにある単一ファイルの作品を 2 つ以上選び、分割動画の順序を確認してください。"
          }
        }
      }
    },
    "error.INVALID_REQUEST": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine rejected an invalid request. Check the app and engine versions before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎拒绝了无效请求，请检查应用与引擎版本后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎拒絕了無效要求，請檢查 App 與引擎版本後再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンが無効なリクエストを拒否しました。アプリとエンジンのバージョンを確認してから続行してください。"
          }
        }
      }
    },
    "error.JOB_BUSY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This movie is still being processed. Wait for the operation to finish or cancel it safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片仍在处理中，请等待操作完成或请求安全取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片仍在處理中，請等待操作完成或要求安全取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作品はまだ処理中です。処理の完了を待つか、安全なキャンセルを要求してください。"
          }
        }
      }
    },
    "error.JOB_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This movie is no longer in the queue. Select another movie or import it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片已不在队列中，请选择其他影片或重新导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片已不在佇列中，請選擇其他影片或重新匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作品はキューにありません。別の作品を選ぶか、もう一度読み込んでください。"
          }
        }
      }
    },
    "error.MESSAGE_TOO_LARGE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request or result exceeds the supported size. Use a smaller selection and check the operation status before repeating a save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求或结果超过大小限制，请缩小选择范围；重复保存前先检查操作状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求或結果超過大小限制，請縮小選取範圍；重複儲存前請先檢查操作狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストまたは結果がサイズの上限を超えています。対象を減らし、保存を繰り返す前に処理の状態を確認してください。"
          }
        }
      }
    },
    "error.METHOD_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled engine does not support this command. Check that the app and engine versions match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置引擎不支持此命令，请检查应用与引擎版本是否匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建引擎不支援此指令，請檢查 App 與引擎版本是否相符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱エンジンはこのコマンドに対応していません。アプリとエンジンのバージョンが一致しているか確認してください。"
          }
        }
      }
    },
    "error.NOT_INITIALIZED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The metadata engine is not ready. Wait for initialization before starting an operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元数据引擎尚未就绪，请等待初始化完成后再操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中繼資料引擎尚未就緒，請等待初始化完成後再操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータエンジンの準備ができていません。初期化が完了してから操作してください。"
          }
        }
      }
    },
    "error.OPERATION_FAILED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed. Your edits were kept; review the details before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败，编辑内容已保留；请检查详情后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失敗，編輯內容已保留；請檢查詳細資訊後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理に失敗しました。編集内容は保持されています。詳細を確認してから再試行してください。"
          }
        }
      }
    },
    "error.OPERATION_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine cannot find this operation. Check the current queue and recovery records before repeating a save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎找不到此操作，请检查当前队列与恢复记录后再考虑重新保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎找不到此操作，請檢查目前佇列與復原記錄後，再考慮重新儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンがこの処理を見つけられません。保存を繰り返す前に、現在のキューと復旧記録を確認してください。"
          }
        }
      }
    },
    "error.PAGE_ID_MISMATCH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page’s movie ID does not match the selected movie. Open the correct movie page before importing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页番号与所选影片不一致，请打开正确影片页面后导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁番號與所選影片不一致，請開啟正確影片頁面後匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページの品番が選択した作品と一致しません。正しい作品ページを開いてから読み込んでください。"
          }
        }
      }
    },
    "error.PAGE_NOT_READY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page is not ready for import. Finish any site verification and open the movie detail page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面尚未准备好导入，请完成网站验证并打开影片详情页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面尚未準備好匯入，請完成網站驗證並開啟影片詳細頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをまだ読み込めません。サイトの認証を完了し、作品の詳細ページを開いてください。"
          }
        }
      }
    },
    "error.PAGE_TOO_LARGE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page exceeds the 2 MiB import limit. No metadata was applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面超过 2 MiB 导入限制，未应用任何资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面超過 2 MiB 匯入限制，未套用任何資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが読み込み上限の 2 MiB を超えています。メタデータは適用されていません。"
          }
        }
      }
    },
    "error.PAGE_UNSUPPORTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This URL or page is not supported by the selected source. Open a supported movie detail page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选来源不支持此网址或页面，请打开支持的影片详情页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選來源不支援此網址或頁面，請開啟支援的影片詳細頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した取得元はこの URL またはページに対応していません。対応する作品詳細ページを開いてください。"
          }
        }
      }
    },
    "error.PARSE_ERROR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine could not read the request. Check the app and engine versions before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎无法解析请求，请检查应用与引擎版本后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎無法解析要求，請檢查 App 與引擎版本後再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンがリクエストを読み取れませんでした。アプリとエンジンのバージョンを確認してから続行してください。"
          }
        }
      }
    },
    "error.PREFERENCES_VERSION_UNSUPPORTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These preferences were written by a newer version. They will be preserved; use a compatible app version to change them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好设置由较新版本写入，已保留原文件；请使用兼容版本修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好設定由較新版本寫入，已保留原檔案；請使用相容版本修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は新しいバージョンで保存されています。元のファイルは保持されます。変更するには対応するアプリのバージョンを使用してください。"
          }
        }
      }
    },
    "error.PROTOCOL_VERSION_MISMATCH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client and bundled engine versions do not match. Rebuild or reinstall the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端与内置引擎版本不匹配，请重新构建或安装应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用戶端與內建引擎版本不相符，請重新建置或安裝 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントと同梱エンジンのバージョンが一致しません。アプリを再ビルドするか再インストールしてください。"
          }
        }
      }
    },
    "error.TRASH_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image-removal request is no longer available. Refresh the movie and review the files again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片移除请求已失效，请刷新影片并重新检查文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片移除要求已失效，請重新整理影片並重新檢查檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像削除のリクエストは無効になりました。作品を更新してファイルを再確認してください。"
          }
        }
      }
    },
    "error.TRASH_PENDING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image removal is still being confirmed. Finish or check that operation before changing this movie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片移除尚未确认完成，请先完成或检查该操作，再修改此影片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片移除尚未確認完成，請先完成或檢查該操作，再修改此影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像削除の完了をまだ確認できていません。その処理を完了するか状態を確認してから、この作品を変更してください。"
          }
        }
      }
    },
    "error.TRASH_PHASE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image removal cannot continue in its current state. Check its status and refresh the movie before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前状态无法继续移除图片，请检查操作状态并刷新影片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前狀態無法繼續移除圖片，請檢查操作狀態並重新整理影片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の状態では画像削除を続けられません。状態を確認し、作品を更新してから再試行してください。"
          }
        }
      }
    },
    "error.WORKSPACE_CAPACITY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace has reached its data limit. Remove unneeded queue items or shorten large edits before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区已达到数据上限，请移除不需要的队列项或缩短较大的编辑内容后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區已達資料上限，請移除不需要的佇列項目或縮短較大的編輯內容後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのデータ量が上限に達しました。不要なキュー項目を取り除くか、大きな編集内容を短くしてから続行してください。"
          }
        }
      }
    },
