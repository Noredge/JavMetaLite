          }
        }
      }
    },
    "unsavedTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved edits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
