    "statusChecked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine status checked. Review the updated movie state before another save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认引擎状态，请检查更新后的影片状态再继续保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンの状態を確認しました。次の保存の前に更新された作品の状態を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認引擎狀態，請檢查更新後的影片狀態再繼續儲存。"
          }
        }
      }
    },
    "unconfirmedStopMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the existing operation status before closing. The app will not resend the save or terminate the engine while its state is unknown. Recovery records and logs are available for inspection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭前请检查现有操作状态。状态未明时应用不会重复提交保存或终止引擎，可通过恢复记录与日志检查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる前に、実行中の処理の状態を確認してください。状態が不明な間は、保存を再送信したりエンジンを終了したりしません。復旧記録とログを確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉前請檢查現有操作的狀態。狀態未明時，App 不會重複提交儲存或終止引擎；可查看復原記錄與日誌。"
          }
        }
      }
    },
