    "emptyMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review local movie metadata, compare sources, and save with confidence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核本地影片资料、比较来源，确认变更后安全保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル動画のメタデータを確認し、取得元を比較して、変更内容を確認してから安全に保存します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審核本地影片資料、比較來源，確認變更後安全儲存。"
          }
        }
      }
    },
