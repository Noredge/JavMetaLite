    "error.REVISION_CONFLICT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This movie changed while you were editing. Your draft is kept. Review the latest values before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间影片资料发生了变化，当前草稿已保留。请检查最新资料后重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にこの作品が変更されました。入力内容は保持されています。再試行する前に最新の値を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間影片資料發生了變化，目前草稿已保留。請檢查最新資料後重試。"
          }
        }
      }
    },
    "error.PLAN_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview is no longer valid. Generate a new preview before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览已失效，请重新生成预览后再保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビューは無効になりました。保存する前に新しいプレビューを作成してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此預覽已失效，請重新生成預覽後再儲存。"
          }
        }
      }
    },
    "error.SOURCE_CHANGED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source file changed. Reimport the affected movies, review their metadata, then generate a new save preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件已发生变化。请重新导入受影响的影片，检查资料后再生成新的保存预览。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルが変更されました。該当する作品を再インポートし、メタデータを確認してから新しい保存プレビューを作成してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源檔案已發生變化。請重新匯入受影響的影片，檢查資料後再產生新的儲存預覽。"
          }
        }
      }
    },
    "error.PATH_CONFLICT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save would conflict with an existing or protected file. Review the paths and overwrite setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存会与已有或受保护的文件冲突，请检查路径与覆盖设置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先が既存または保護対象のファイルと競合します。パスと上書き設定を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存會與已有或受保護的檔案衝突，請檢查路徑與覆蓋設定。"
          }
        }
      }
    },
    "error.ACCESS_DENIED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app cannot access a required file. Select the location again or check its permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问所需文件，请重新选择位置或检查访问权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なファイルにアクセスできません。場所を選び直すか、アクセス権を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取所需檔案，請重新選擇位置或檢查存取權限。"
          }
        }
      }
    },
    "error.VOLUME_UNAVAILABLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source volume is unavailable. Reconnect it before creating a new preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源卷不可用，请重新连接后再生成预览。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のボリュームを利用できません。再接続してから新しいプレビューを作成してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源卷宗不可用，請重新連接後再生成預覽。"
          }
        }
      }
    },
    "error.PROVIDER_RATE_LIMITED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source is limiting requests. Wait before retrying; your current metadata is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源正在限制请求，请稍后重试。当前资料已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得元がリクエストを制限しています。時間をおいて再試行してください。現在のメタデータは保持されています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源正在限制請求，請稍後重試。目前資料已保留。"
          }
        }
      }
    },
    "error.PARTIAL_SOURCE_FAILURE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sources failed. Your current values and successful source results are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分来源查询失败，当前资料与已成功的来源结果已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の取得元で失敗しました。現在の値と取得に成功した結果は保持されています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分來源查詢失敗，目前資料與已成功的來源結果已保留。"
          }
        }
      }
    },
    "error.UNSUPPORTED_CAPABILITY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation is not available in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未提供该操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは利用できない操作です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本尚未提供該操作。"
          }
        }
      }
    },
    "error.RECOVERY_REQUIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier save needs inspection. Review the recovery records before another save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的保存需要检查，请处理恢复记录后再保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の保存について確認が必要です。次の保存の前に復旧記録を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的儲存需要檢查，請處理復原記錄後再儲存。"
          }
        }
      }
    },
    "error.WORKER_UNAVAILABLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine is unavailable or its operation state is not confirmed. Do not retry a save until its status is known."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎不可用或操作状态尚未确认。确认状态前请勿重复提交保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンを利用できないか、処理の状態を確認できません。状態が判明するまで保存を再実行しないでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引擎不可用或操作狀態尚未確認。確認狀態前請勿重複提交儲存。"
          }
        }
      }
    },
    "error.PROTOCOL_MISMATCH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Client and bundled engine versions do not match. Rebuild or reinstall the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客户端与内置引擎版本不匹配，请重新构建或安装应用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントと同梱エンジンのバージョンが一致しません。アプリを再ビルドするか再インストールしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "客戶端與內建引擎版本不相符，請重新建置或安裝App。"
          }
        }
      }
    },
