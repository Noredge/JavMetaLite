    "browserReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to import into %@. Review the imported fields before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可导入到 %@；保存前请审核导入的字段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可匯入至 %@；儲存前請審核匯入的欄位。"
