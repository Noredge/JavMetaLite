    "recoveryExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect the recorded file outcome before archiving a transaction record. Verification and archiving never replay a save or change your media."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先核验记录对应的文件结果，再归档事务记录。核验和归档不会重放保存或修改媒体文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先核驗記錄對應的檔案結果，再封存交易記錄。核驗和封存不會重播儲存或修改媒體檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されたファイルの状態を確認してから記録を保管します。保存の再実行やメディアの変更は行いません。"
          }
        }
      }
    },
