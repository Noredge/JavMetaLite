<Window x:Class="JavMetaLite.App.DuplicateMovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Duplicate.Title}" Width="820" Height="570" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Duplicate.Intro}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ListBox x:Name="CandidatesList" Grid.Row="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                 SelectionChanged="Selection_Changed">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="4" Margin="3" CornerRadius="5">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#1E2A38"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="#203D68"/>
                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="6"/>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
            <Button Content="↑" Click="Up_Click" Width="45" Margin="0,0,8,0"/>
            <Button Content="↓" Click="Down_Click" Width="45"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="RestrictionText" Text="{DynamicResource Duplicate.Restriction}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <CheckBox x:Name="ConfirmPartsCheckBox" Checked="Selection_Changed" Unchecked="Selection_Changed">
                <TextBlock Text="{DynamicResource Duplicate.ConfirmParts}" TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveOneButton" Content="{DynamicResource Duplicate.SaveOne}" Click="SaveOne_Click" Margin="0,0,8,8"/>
            <Button x:Name="SavePartsButton" Content="{DynamicResource Duplicate.SaveParts}" Click="SaveParts_Click" Margin="0,0,8,8"/>
            <Button Content="{DynamicResource Duplicate.Skip}" Click="Skip_Click" Margin="0,0,8,8"/>
            <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Margin="0,0,0,8"/>
        </WrapPanel>
    </Grid>
</Window>
