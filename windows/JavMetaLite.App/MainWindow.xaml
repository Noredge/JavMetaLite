<Window x:Class="JavMetaLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:JavMetaLite.App"
        xmlns:services="clr-namespace:JavMetaLite.Core.Services;assembly=JavMetaLite.Core"
        Title="{DynamicResource App.Title}"
        Icon="/JavMetaLite;component/Resources/Brand/JavMetaLite.ico"
        Width="1120" Height="790" MinWidth="930" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        AllowDrop="True"
        PreviewDrop="Window_Drop"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="OperationProgressStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="108" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource TabBrush}" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2.5" />
                            <Border x:Name="Sweep" Visibility="Collapsed" Width="32" HorizontalAlignment="Center"
                                    Background="{TemplateBinding Foreground}" CornerRadius="2.5">
                                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="MovingProgress">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                From="-70" To="70" Duration="0:0:1.3" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="MovingProgress" />
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourceBadgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="CandidateMenuRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Background="Transparent"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly"
                                          local:PreciseScrollBehavior.Axis="Vertical">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="540" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="CandidateBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CandidateBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueFilterItem" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock x:Name="CategoryCount" Grid.Column="1" Text="{Binding StringFormat='({0})'}"
                                           Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="WorkspaceSymbol" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="ReviewLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,8" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandIconImage" Source="Resources/Brand/JavMetaLite-64.png" Width="32" Height="32" />
                    <TextBlock Text="JavMetaLite" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,14,0" />
                    <Button x:Name="QueueToggleButton" Style="{StaticResource WorkspaceIcon}" ToolTip="{DynamicResource Desk.ToggleQueue}" AutomationProperties.Name="{DynamicResource Desk.ToggleQueue}" Click="ToggleQueue_Click">
                        <Path Style="{StaticResource WorkspaceSymbol}" Data="M3,3 H19 Q21,3 21,5 V17 Q21,19 19,19 H3 Q1,19 1,17 V5 Q1,3 3,3 Z M8,3 V19" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ChooseVideoButton" Click="ChooseFile_Click" AutomationProperties.Name="{DynamicResource Main.AddMovies}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WorkspaceSymbol}" Width="14" Height="14" Data="M1,8 H15 M8,1 V15" />
                            <TextBlock Text="{DynamicResource Main.AddMovies}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PreferencesButton" Style="{StaticResource WorkspaceIcon}" ToolTip="{DynamicResource Desk.Preferences}" AutomationProperties.Name="{DynamicResource Desk.Preferences}" Click="Preferences_Click">
                        <Path Style="{StaticResource WorkspaceSymbol}" Data="M9,2 H13 L14,5 L17,5 L19,8 L17,11 L19,14 L17,17 L14,17 L13,20 H9 L8,17 L5,17 L3,14 L5,11 L3,8 L5,5 L8,5 Z M14,11 A3,3 0 1 1 8,11 A3,3 0 1 1 14,11 Z" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=PreferencesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <Label Content="{DynamicResource Main.LanguageTooltip}" />
                    <ComboBox x:Name="LanguageComboBox"

                              Width="160"
                              Style="{StaticResource DarkComboBox}"
                              ToolTip="{DynamicResource Main.LanguageTooltip}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                        <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                    </ComboBox>
                    <Label Content="{DynamicResource Desk.Appearance}" Margin="0,8,0,0" />
                    <ComboBox x:Name="AppearanceChoice" Style="{StaticResource DarkComboBox}" SelectedIndex="0" SelectionChanged="Appearance_Changed">
                        <ComboBoxItem Tag="system" Content="{DynamicResource Desk.System}" />
                        <ComboBoxItem Tag="light" Content="{DynamicResource Desk.Light}" />
                        <ComboBoxItem Tag="dark" Content="{DynamicResource Desk.Dark}" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="DeskLayout" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QueueColumn" Width="0" />
                <ColumnDefinition x:Name="QueueSpacerColumn" Width="0" />
                <ColumnDefinition x:Name="ArtworkColumn" Width="300" MinWidth="170" MaxWidth="440" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="QueueSplitter" Grid.RowSpan="2"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Visibility="Collapsed" />

            <GridSplitter Grid.Row="1" Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border x:Name="QueuePanel" Grid.RowSpan="2"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,14,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,0,5">
                        <Button DockPanel.Dock="Right" x:Name="QueueOptionsButton" Style="{StaticResource WorkspaceIcon}"
                                Click="QueueOptions_Click" ToolTip="{DynamicResource Desk.Selection}" AutomationProperties.Name="{DynamicResource Desk.Selection}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="QueueOptions" Placement="Bottom" Style="{StaticResource CandidateContextMenu}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource CandidateMenuItem}">
                                            <Setter Property="MinWidth" Value="140" />
                                            <Setter Property="Padding" Value="12,6" />
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="SelectRecognizedQueueButton" Header="{DynamicResource Discovery.SelectRecognized}" Click="SelectRecognizedQueue_Click" />
                                    <MenuItem x:Name="SelectPendingQueueButton" Header="{DynamicResource Main.QueueSelectPending}" Click="SelectPendingQueue_Click" />
                                    <MenuItem x:Name="SelectIssuesQueueButton" Header="{DynamicResource Main.QueueSelectIssues}" Click="SelectIssuesQueue_Click" />
                                    <MenuItem x:Name="SelectNoneQueueButton" Header="{DynamicResource Main.QueueSelectNone}" Click="SelectNoneQueue_Click" />
                                    <Separator />
                                    <MenuItem x:Name="RemoveSelectedQueueButton" Header="{DynamicResource Main.QueueRemoveSelected}" Click="RemoveSelectedQueue_Click" />
                                    <MenuItem x:Name="ClearQueueButton" Header="{DynamicResource Main.QueueClear}" Click="ClearQueue_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path Style="{StaticResource WorkspaceSymbol}" Height="4" Width="18"
                                  Data="M2,2 A1,1 0 1 1 2,2.1 M10,2 A1,1 0 1 1 10,2.1 M18,2 A1,1 0 1 1 18,2.1" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Main.Queue}" FontWeight="SemiBold" />
                            <TextBlock x:Name="QueueCountText" Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="6,0,3,8">
                        <CheckBox x:Name="QueueCheckAll" DockPanel.Dock="Left" Click="QueueCheckAll_Click" Margin="0"
                                  ToolTip="{DynamicResource Main.QueueSelectAll}" AutomationProperties.Name="{DynamicResource Main.QueueSelectAll}" />
                        <ComboBox x:Name="QueueFilterComboBox"
                                  MinHeight="30" Margin="8,0,0,0" SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource QueueFilterItem}"
                                  SelectionChanged="QueueFilter_Changed"
                                  ToolTip="{DynamicResource Main.QueueFilterTooltip}">
                            <ComboBoxItem x:Name="QueueFilterAllItem" Content="{DynamicResource Main.QueueFilter.All}" Tag="all" IsSelected="True" DataContext="0" />
                            <ComboBoxItem x:Name="QueueFilterPendingItem" Content="{DynamicResource Main.QueueFilter.Pending}" Tag="pending" DataContext="0" />
                            <ComboBoxItem x:Name="QueueFilterIssuesItem" Content="{DynamicResource Main.QueueFilter.Issues}" Tag="issues" DataContext="0" />
                        </ComboBox>
                    </DockPanel>
                    <ListBox x:Name="MovieQueueList"
                             Grid.Row="2"
                             Background="{DynamicResource PanelAltBrush}"
                             BorderThickness="0"
                             Padding="0"
                             SelectionChanged="MovieQueueList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.PanningMode="VerticalOnly"
                             local:PreciseScrollBehavior.Axis="Vertical">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7"
                                        ClipToBounds="True">
                                    <ScrollViewer x:Name="QueueScrollViewer"
                                                  Background="{TemplateBinding Background}"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                  Focusable="False"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TabBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="3,0,0,0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding VideoPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                               IsChecked="{Binding IsSelectedForBatch, Mode=TwoWay}"
                                               ToolTip="{DynamicResource Queue.SelectedForBatch}"
                                               Margin="0" PreviewMouseLeftButtonDown="QueueCheck_PreviewMouseLeftButtonDown" AutomationProperties.Name="{Binding FileName}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                     <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searching}">
                                                         <Setter Property="IsEnabled" Value="False" />
                                                     </DataTrigger>
                                                     <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.Saving}">
                                                         <Setter Property="IsEnabled" Value="False" />
                                                     </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Border Grid.Column="1" Width="37" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            CornerRadius="4" Background="{DynamicResource InputBrush}">
                                        <Grid>
                                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Data="M2,3 H18 V17 H2 Z M8,7 L13,10 L8,13 Z" />
                                            <local:QueueThumbnail x:Name="RowThumbnail" VideoPath="{Binding VideoPath}"
                                                PosterPath="{Binding LocalArtworkCandidate.LocalPosterPath}" CoverPath="{Binding LocalArtworkCandidate.LocalFanartPath}"
                                                Stretch="UniformToFill" IsHitTestVisible="False">
                                                <Image.Clip><RectangleGeometry Rect="0,0,37,50" RadiusX="4" RadiusY="4" /></Image.Clip>
                                            </local:QueueThumbnail>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="{Binding Metadata.Title}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Metadata.Title}" Value=""><Setter Property="Text" Value="{Binding FileName}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Metadata.Id}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <Border x:Name="QueueReviewBadge" HorizontalAlignment="Left"
                                                Margin="0,5,0,0"
                                                Padding="7,2"
                                                CornerRadius="8"
                                                ToolTip="{Binding LastSearchError.Message}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsId}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searching}">
                                                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsReview}">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessFillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasPartialSourceFailure}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasLowResolutionCover}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchFailed}">
                                                            <Setter Property="Background" Value="{DynamicResource ErrorFillBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchCanceled}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningFillBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Queue.Search.Searchable}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsId}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.NeedsId}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource BatchSourceWarningBrush}" />
                                                        </DataTrigger>
