                                MinWidth="24"
                                MinHeight="26"
                                Margin="0,0,23,0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="{DynamicResource Main.Source.ConfigureTooltip}"
                                AutomationProperties.Name="{DynamicResource Main.Source.EditRules}"
                                Click="SourceProfile_Click"
                                Visibility="Collapsed">
                                <TextBlock Text="⚙"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="13"
                                    Foreground="{DynamicResource MutedBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="SearchQueueButton" Grid.Column="1" Margin="10,0,0,0"
                                Height="{StaticResource QueryControlHeight}" Click="WorkspaceSearch_Click" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
            <Border x:Name="EmptyDesk" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Background="{DynamicResource WindowBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <Image Source="Resources/Brand/JavMetaLite-64.png" Width="60" Height="60" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource Desk.Empty}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="{DynamicResource Desk.Drop}" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20" />
                    <Button Content="{DynamicResource Main.AddMovies}" Style="{StaticResource PrimaryButton}" Click="ChooseFile_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="OutputDrawer" Grid.Row="1" Grid.Column="5" Visibility="Collapsed" Width="310" Margin="8,0,0,0" Padding="18,12,14,16"
                    HorizontalAlignment="Right" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="CloseOutputButton" DockPanel.Dock="Right" Style="{StaticResource WorkspaceIcon}" Click="ToggleSaveSettings_Click"
                                ToolTip="{DynamicResource Common.Close}" AutomationProperties.Name="{DynamicResource Common.Close}">
                            <Path Style="{StaticResource WorkspaceSymbol}" Data="M4,4 L16,16 M16,4 L4,16" />
                        </Button>
                        <TextBlock Text="{DynamicResource Desk.Output}" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SaveSettingsOptionsPanel" Margin="0,0,4,0">
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Margin" Value="0,7" />
                                </Style>
                                <Style x:Key="OutputGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource ReviewLabel}">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,15,0,6" />
                                </Style>
                            </StackPanel.Resources>
                            <DockPanel x:Name="InputFileDetails" Margin="0,0,0,6">
                                <Button x:Name="RemoveCurrentVideoButton" DockPanel.Dock="Right" Style="{StaticResource WorkspaceIcon}"
                                    ToolTip="{DynamicResource Main.RemoveCurrentMovieTooltip}" AutomationProperties.Name="{DynamicResource Main.RemoveCurrentMovie}"
                                    Click="RemoveCurrentVideo_Click" Visibility="Collapsed">
                                    <Path Style="{StaticResource WorkspaceSymbol}" Data="M3,4 H13 M3,9 H10 M3,14 H8 M13,12 L20,19 M20,12 L13,19" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="FilePathText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Button x:Name="ApplySelectionSettingsButton" Margin="0,8,0,4" Click="ApplySelectionSettings_Click" />
                            <TextBlock Style="{StaticResource OutputGroupLabel}" Text="{DynamicResource Main.Output}" />
                            <CheckBox x:Name="WriteNfoCheckBox" Content="{DynamicResource Main.WriteNfo}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" />
                            <CheckBox x:Name="DownloadPosterCheckBox" Content="{DynamicResource Main.DownloadPoster}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadPosterTooltip}" />
                            <CheckBox x:Name="DownloadFanartCheckBox" Content="{DynamicResource Main.DownloadFanart}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadFanartTooltip}" />
                            <CheckBox x:Name="DownloadExtrafanartCheckBox" Content="{DynamicResource Main.DownloadExtrafanart}" IsChecked="False" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadExtrafanartTooltip}" />
                            <TextBlock Style="{StaticResource OutputGroupLabel}" Text="{DynamicResource Main.TargetLocation}" />
                            <ComboBox x:Name="TargetModeComboBox"
                                    MaxWidth="360"
                                    SelectedIndex="0"
                                    Style="{StaticResource DarkComboBox}"
                                    SelectionChanged="TargetMode_Changed"
                                    Margin="0">
                                <ComboBoxItem Content="{DynamicResource Desk.MovieFolder}" ToolTip="{DynamicResource Main.Target.VideoDirectory}" Tag="VideoDirectory" IsSelected="True" />
                                <ComboBoxItem Content="{DynamicResource Main.Target.SourceNumberFolder}" Tag="SourceNumberFolder" />
                                <ComboBoxItem Content="{DynamicResource Main.Target.CustomRootNumberFolder}" Tag="CustomRootNumberFolder" />
                                </ComboBox>
                            <Grid x:Name="CustomTargetPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBox x:Name="CustomRootTextBox"
                                    Padding="8,5"
                                    FontSize="12"
                                    TextChanged="CustomRootText_Changed"
                                    LostFocus="CustomRootTextBox_LostFocus"
                                    KeyDown="CustomRootTextBox_KeyDown"
                                    ToolTip="{DynamicResource Main.CustomRootTooltip}" />
                                    <Button x:Name="RecentRootsButton" Margin="0,6,0,0"
                                    Content="{DynamicResource Main.RecentRoots}"
                                    IsEnabled="False"
                                    Padding="12,6"
                                    Click="RecentRoots_Click"
                                    ToolTip="{DynamicResource Main.RecentRootsTooltip}" />
                                    <Button x:Name="ChooseTargetFolderButton" Margin="0,6,0,0"
                                    Content="{DynamicResource Common.SelectFolder}"
                                    Padding="12,6"
                                    Click="ChooseTargetFolder_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TargetPathHintText"
                                    Text="{DynamicResource Main.TargetHint}"
                                    Foreground="{DynamicResource MutedBrush}"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0" />
                            <Expander Header="{DynamicResource Main.NamingAndBehavior}" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0">
                                <StackPanel Margin="2,6,0,0">
                                    <CheckBox x:Name="ReplaceLocalExtrafanartCheckBox"
                                    Content="{DynamicResource Main.ReplaceLocalExtrafanart}"
                                    IsChecked="False"
                                    IsEnabled="{Binding IsChecked, ElementName=DownloadExtrafanartCheckBox}"
                                    Checked="SaveConfiguration_Changed"
                                    Unchecked="SaveConfiguration_Changed"
                                    ToolTip="{DynamicResource Main.ReplaceLocalExtrafanartTooltip}" />
                                    <CheckBox x:Name="IncludeIdInTitleCheckBox"
                                    Content="{DynamicResource Main.IncludeIdInTitle}"
                                    IsChecked="True"
                                    IsEnabled="{Binding IsChecked, ElementName=WriteNfoCheckBox}"
                                    Checked="IncludeIdInTitle_Changed"
                                    Unchecked="IncludeIdInTitle_Changed"
                                    ToolTip="{DynamicResource Main.IncludeIdInTitleTooltip}" />
                                    <CheckBox x:Name="RenameVideoCheckBox"
                                    Content="{DynamicResource Main.RenameVideo}"
                                    IsChecked="False"
                                    Checked="TargetOption_Changed"
                                    Unchecked="TargetOption_Changed"
                                    ToolTip="{DynamicResource Main.RenameVideoTooltip}" />
                                    <CheckBox x:Name="SkipSavePreviewCheckBox"
                                    Content="{DynamicResource Main.SkipSavePreview}"
                                    IsChecked="False"
                                    Checked="SavePreferencePresentation_Changed"
                                    Unchecked="SavePreferencePresentation_Changed"
                                    ToolTip="{DynamicResource Main.SkipSavePreviewTooltip}" />
                                    <CheckBox x:Name="SkipCrossVolumeVerificationCheckBox"
                                    Content="{DynamicResource Main.SkipCrossVolumeVerification}"
                                    IsChecked="False"
                                    Visibility="Collapsed"
                                    Checked="TargetOption_Changed"
                                    Unchecked="TargetOption_Changed"
                                    ToolTip="{DynamicResource Main.SkipCrossVolumeVerificationTooltip}" />
                                </StackPanel>
                            </Expander>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,6" />
                            <CheckBox x:Name="RememberPreferencesCheckBox"
                                    Content="{DynamicResource Main.RememberPreferences}"
                                    IsChecked="False"
                                    ToolTip="{DynamicResource Main.RememberUnifiedPreviewTooltip}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

            </Border>
        </Grid>

        <Grid x:Name="DropOverlay" Grid.Row="1" Panel.ZIndex="10" Margin="8"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="{DynamicResource WindowBrush}" Opacity="0.86" CornerRadius="8" />
            <Border BorderBrush="{DynamicResource TabBrush}" BorderThickness="2" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Width="30" Height="32" Stretch="Uniform" Stroke="{DynamicResource TabBrush}" StrokeThickness="1.6"
                          Data="M10,1 V14 M5,9 L10,14 L15,9 M2,15 V20 H18 V15" />
                    <TextBlock Text="{DynamicResource Intake.Release}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="StatusFooter" Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Desk.Ready}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <StackPanel x:Name="OperationProgressPanel" Grid.Column="1" Visibility="Collapsed"
                                Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="{DynamicResource Progress.Overall}">
                        <ProgressBar x:Name="OperationProgressBar" Style="{StaticResource OperationProgressStyle}"
                                     Minimum="0" Maximum="100" VerticalAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource Progress.Overall}" />
                        <TextBlock x:Name="ProgressPercent" MinWidth="36" Margin="6,0,0,0"
                                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Typography.NumeralAlignment="Tabular"
                                   Text="{Binding Value, ElementName=OperationProgressBar, StringFormat={}{0:0}%}" />
                    </StackPanel>
                </Grid>
                <Button x:Name="RetryFailedSourcesButton"
                        Grid.Column="2"
                        Content="{DynamicResource SearchFeedback.RetryFailed}"
                        Click="RetryFailedSources_Click"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Background="{DynamicResource PanelAltBrush}"
                        Visibility="Collapsed" />
                <Button x:Name="CancelOperationButton"
                        Grid.Column="3"
                        Content="{DynamicResource Main.CancelOperation}"
                        Click="CancelOperation_Click"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Background="{DynamicResource ErrorFillBrush}"
                        BorderBrush="{DynamicResource ErrorTextBrush}"
                        Visibility="Collapsed" />
                <StackPanel x:Name="SingleSavePanel" Grid.Column="4" Orientation="Horizontal" Margin="10,0">
                        <Button x:Name="SaveSelectedButton" Style="{StaticResource PrimaryButton}" ToolTip="{DynamicResource Main.SaveShortcutTooltip}" Click="SaveSelected_Click" />
                        <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="{DynamicResource Common.Save}"
                            Click="Save_Click" />
                </StackPanel>
                <Button Grid.Column="5" x:Name="LogsButton" Style="{StaticResource WorkspaceIcon}" ToolTip="{DynamicResource Common.OpenLogs}" AutomationProperties.Name="{DynamicResource Common.OpenLogs}" Click="OpenLogs_Click">
                        <Path Style="{StaticResource WorkspaceSymbol}" Data="M5,2 H15 L19,6 V20 H5 Z M14,2 V7 H19 M8,11 H16 M8,15 H15" />
                    </Button>
                <TextBlock x:Name="VersionText" Grid.Column="6" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
