                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Canceled}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource BatchSourceWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
