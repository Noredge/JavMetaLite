<Window x:Class="JavMetaLite.App.ArtworkViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JavMetaLite.App"
        Title="{DynamicResource ArtworkViewer.Title}"
        Width="1040"
        Height="760"
        MinWidth="640"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SourceBadgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#6FA8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#233650" />
                                <Setter Property="Foreground" Value="#9BC1FF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Background="Transparent"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly"
                                          local:PreciseScrollBehavior.Axis="Vertical">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="540" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="CandidateBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CandidateBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArtworkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D6FD2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArtworkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ArtworkComboBoxItem}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="10,7,28,7"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Width="8" Height="5" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Fill="#B8C5D6" Stretch="Fill"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        Background="#10161E"
                                        BorderBrush="#3A4A61"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  IsDeferredScrollingEnabled="False"
                                                  PanningMode="VerticalOnly"
                                                  local:PreciseScrollBehavior.Axis="Vertical">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArtworkThumbnailCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Border x:Name="CheckBorder"
                                    Margin="1"
                                    Background="#6610161E"
                                    BorderBrush="#8093A4B8"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <Path x:Name="CheckMark"
                                  Margin="3"
                                  Data="M 2 6 L 5 9 L 11 3"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#CC1B2330" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#E64F8CFF" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArtworkTitleText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ArtworkPositionText"
                           Grid.Column="1"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource ArtworkViewer.TypeLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ArtworkTypeComboBox"
                          Grid.Column="1"
                          Width="210"
                          Style="{StaticResource ArtworkComboBox}"
                          SelectionChanged="ArtworkType_SelectionChanged" />
                <TextBlock x:Name="PreloadProgressText"
                           Grid.Column="2"
                           Margin="12,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <StackPanel x:Name="ArtworkSourceSelectorPanel"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,12,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ArtworkSourceLabelText"
                               Text="{DynamicResource ArtworkViewer.ArtworkSourceLabel}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <Button x:Name="ArtworkSourceSelectorButton"
                            Style="{StaticResource SourceBadgeButton}"
                            Click="ArtworkSourceSelector_Click"
                            Margin="4,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="CurrentSampleSelectionCheckBox"
                           Grid.Column="4"
                          Content="{DynamicResource ArtworkViewer.IncludeSample}"
                          Checked="CurrentSampleSelection_Changed"
                          Unchecked="CurrentSampleSelection_Changed"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border x:Name="ArtworkPreviewBorder"
                Grid.Row="1"
                Background="#080C12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <Grid>
                <Image x:Name="ArtworkImage" Stretch="Uniform" />
                <TextBlock x:Name="EmptyTypeText"
                           Text="{DynamicResource ArtworkViewer.EmptyType}"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <Border x:Name="ArtworkLoadStatePanel"
                        Background="#E6080C12"
                        CornerRadius="8"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ArtworkLoadStateText"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ArtworkLoadDetailText"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,7,0,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="ArtworkDimensionsText"
                   Grid.Row="2"
                   Margin="0,5,4,0"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   Visibility="Collapsed" />

        <StackPanel x:Name="ArtworkFilmstripSection"
                    Grid.Row="3"
                    Margin="0,6,0,0">
            <Button x:Name="ArtworkFilmstripToggleButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    MinWidth="0"
                    MinHeight="36"
                    Padding="9,5"
                    Background="#111821"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="ToggleFilmstrip_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="ArtworkFilmstripChevronPath"
                          Style="{StaticResource DisclosureChevronPath}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource ArtworkViewer.ImageList}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ArtworkFilmstripSummaryText"
                               Grid.Column="4"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <StackPanel x:Name="ArtworkFilmstripPanel"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
            <StackPanel x:Name="LocalThumbnailSection">
                <Grid Margin="2,0,2,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LocalImagesHeaderText"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button x:Name="SelectAllLocalButton"
                                Content="{DynamicResource ArtworkViewer.SelectAllLocal}"
                                Click="SelectAllLocal_Click"
                                MinHeight="30"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button x:Name="SelectNoLocalButton"
                                Content="{DynamicResource ArtworkViewer.SelectNoLocal}"
                                Click="SelectNoLocal_Click"
                                MinHeight="30"
                                Padding="10,4"
                                Margin="0,0,6,0" />
                        <Button x:Name="DeleteSelectedLocalButton"
                                Style="{StaticResource DangerButton}"
                                Click="DeleteSelectedLocal_Click"
                                MinHeight="30"
                                Padding="10,4" />
                    </WrapPanel>
                </Grid>
                <Border x:Name="LocalThumbnailStripBorder"
                        Height="100"
                        Padding="5"
                        Background="#111821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ScrollViewer x:Name="LocalThumbnailScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  IsDeferredScrollingEnabled="False"
                                  local:PreciseScrollBehavior.Axis="Horizontal">
                        <StackPanel x:Name="LocalThumbnailPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel x:Name="OnlineThumbnailSection" Margin="0,8,0,0">
                <Grid Margin="2,0,2,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OnlineImagesHeaderText"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="SampleSelectionSummaryText"
                                   Margin="0,0,10,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <Button x:Name="SelectAllSamplesButton"
                                Content="{DynamicResource ArtworkViewer.SelectAllSamples}"
                                Click="SelectAllSamples_Click"
                                MinHeight="30"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                Visibility="Collapsed" />
                        <Button x:Name="SelectNoSamplesButton"
                                Content="{DynamicResource ArtworkViewer.SelectNoSamples}"
                                Click="SelectNoSamples_Click"
                                MinHeight="30"
                                Padding="10,4"
                                Visibility="Collapsed" />
                    </WrapPanel>
                </Grid>
                <Border x:Name="OnlineThumbnailStripBorder"
                        Height="100"
                        Padding="5"
                        Background="#111821"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <ScrollViewer x:Name="ThumbnailScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly"
                                      IsDeferredScrollingEnabled="False"
                                      local:PreciseScrollBehavior.Axis="Horizontal">
                            <StackPanel x:Name="ThumbnailPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                        <TextBlock x:Name="OnlineEmptySourceText"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ArtworkViewer.KeyboardHint}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       Margin="0,0,10,0"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="PreviousButton"
                        Content="{DynamicResource ArtworkViewer.Previous}"
                        Click="Previous_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="NextButton"
                        Content="{DynamicResource ArtworkViewer.Next}"
                        Click="Next_Click"
                        Margin="0,0,8,0" />
                <Button x:Name="ApplySelectionButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="{DynamicResource ArtworkViewer.ApplySelection}"
                        Click="ApplySelection_Click"
                        Margin="0,0,8,0"
                        Visibility="Collapsed" />
                <Button Content="{DynamicResource Common.Close}"
                        Click="Close_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
