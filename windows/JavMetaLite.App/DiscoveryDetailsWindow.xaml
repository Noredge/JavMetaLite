<Window x:Class="JavMetaLite.App.DiscoveryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JavMetaLite.App"
        Title="{DynamicResource Discovery.DetailsTitle}"
        Width="720" Height="440" MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="{DynamicResource Discovery.DetailsTitle}" FontSize="20"
                   FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBox x:Name="DetailsText" Grid.Row="1"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False" ScrollViewer.IsDeferredScrollingEnabled="False"
                 local:PreciseScrollBehavior.Axis="Vertical" />
        <Button Grid.Row="2" Content="{DynamicResource Common.Close}"
                HorizontalAlignment="Right" Margin="0,14,0,0"
                IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
