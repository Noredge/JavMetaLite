<Window x:Class="JavMetaLite.App.MovieInputPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Main.AddMovies}" Width="740" Height="550" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Border Padding="20,16" Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Main.AddMovies}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Intake.Help}" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="UpButton" MinWidth="36" Padding="4" Click="Up_Click" ToolTip="{DynamicResource Intake.Up}" AutomationProperties.Name="{DynamicResource Intake.Up}">
                    <Path Data="M1,9 L8,2 L15,9 M8,2 V17" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                </Button>
                <ComboBox x:Name="DriveBox" Grid.Column="1" Margin="5,0" Style="{StaticResource DarkComboBox}"
                          AutomationProperties.Name="{DynamicResource Intake.Drive}" SelectionChanged="Drive_Changed" />
                <TextBox x:Name="AddressBox" Grid.Column="2" KeyDown="Address_KeyDown" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{DynamicResource Intake.Path}" ToolTip="{DynamicResource Intake.Path}" />
                <Button Grid.Column="3" MinWidth="36" Margin="4,0,0,0" Padding="4" Click="Go_Click" ToolTip="{DynamicResource Intake.Go}" AutomationProperties.Name="{DynamicResource Intake.Go}">
                    <Path Data="M1,8 H16 M10,2 L16,8 L10,14" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" />
                </Button>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="PickPageBox" Content="{DynamicResource Main.QueueSelectAll}" Click="PickPage_Click" Margin="8,4,0,6" />
                <ListBox Grid.Row="1" x:Name="EntriesList" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="Entries_KeyDown"
                         MouseDoubleClick="Entries_DoubleClick" AutomationProperties.Name="{DynamicResource Intake.List}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelAltBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FullPath}" Margin="3,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" /><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsPicked, Mode=OneWay}" Click="Pick_Click" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Name}" Margin="0" />
                                <Path Grid.Column="1" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Path.Style><Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
                                        <Setter Property="Data" Value="M2,2 H16 V17 H2 Z M7,6 L12,9 L7,12 Z" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Data" Value="M1,5 V3 H7 L9,5 H18 V16 H1 Z" />
                                            <Setter Property="Stroke" Value="{DynamicResource TabBrush}" />
                                        </DataTrigger></Style.Triggers>
                                    </Style></Path.Style>
                                </Path>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Click="OpenFolder_Click" MinWidth="32" MinHeight="28" Padding="4,0"
                                        AutomationProperties.Name="{DynamicResource Intake.OpenFolder}" ToolTip="{DynamicResource Intake.OpenFolder}">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style></Button.Style>
                                    <Path Data="M2,1 L8,7 L2,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" x:Name="BrowserStatus" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" />
            </Grid>
            <DockPanel Grid.Row="3" Margin="0,8" LastChildFill="True">
                <Button x:Name="PickCurrentButton" DockPanel.Dock="Right" Content="{DynamicResource Intake.CurrentFolder}" Click="PickCurrent_Click" Padding="7,3" />
                <Button x:Name="SelectionViewButton" HorizontalAlignment="Left" Click="SelectionView_Click" Padding="7,3" />
            </DockPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="AddButton" Content="{DynamicResource Intake.AddSelected}" Style="{StaticResource PrimaryButton}" Click="Accept_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
