# .NET build output
**/bin/
**/obj/
artifacts/
TestResults/

# Optional project-local SDK used by Codex validation runs
.dotnet-sdk/
.dotnet-home/
.dotnet-sdk.zip

# IDE and user state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Published executables stay outside version control
publish/
publish-*/
release/
*.exe
*.pdb

# WebView2 browser profiles and local caches
*.WebView2/
EBWebView/

# Operating-system files
Thumbs.db
Desktop.ini
.DS_Store

# Keep retired Windows 1.2.0 preview screenshots out of version control.
docs/images/javmetalite-v1.2.0-preview.*.png

# Native macOS local build and editor state
macos/.build/
macos/.swiftpm/
**/xcuserdata/
*.xcresult/

# Python verification cache
scripts/**/__pycache__/
