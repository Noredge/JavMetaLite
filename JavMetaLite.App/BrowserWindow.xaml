<Window x:Class="JavMetaLite.App.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource Browser.Title}"
        Width="1050" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#151B23" BorderBrush="#2A3544" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Browser.Instruction}" Foreground="#F1F5F9" FontFamily="Segoe UI, Microsoft YaHei UI" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="UrlText" Foreground="#93A4B8" FontFamily="Segoe UI" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,14,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Browser.ReadCurrent}" Click="Import_Click" Padding="18,9" Background="#4F8CFF" Foreground="White" BorderBrush="#6FA2FF" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" NavigationCompleted="Browser_NavigationCompleted" />

        <Border Grid.Row="2" Background="#151B23" BorderBrush="#2A3544" BorderThickness="0,1,0,0" Padding="16,10">
            <TextBlock Text="{DynamicResource Browser.Privacy}" Foreground="#93A4B8" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="11" />
        </Border>
    </Grid>
</Window>
