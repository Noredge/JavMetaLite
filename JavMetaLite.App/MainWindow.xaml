<Window x:Class="JavMetaLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JAV Metadata Lite"
        Width="1120" Height="790" MinWidth="930" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151B23" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2330" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3544" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="MutedBrush" Color="#93A4B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SourceBadgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#6FA8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,0,6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#233650" />
                                <Setter Property="Foreground" Value="#9BC1FF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="CandidateMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="540" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="CandidateBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CandidateBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#263244" />
            <Setter Property="BorderBrush" Value="#36465D" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#6FA2FF" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D6FD2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#607086" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Width="8" Height="5" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Fill="#B8C5D6" Stretch="Fill"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0"
                                        Background="#10161E"
                                        BorderBrush="#3A4A61"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111821" BorderBrush="#253040" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="#244B8F" Margin="0,0,14,0">
                    <TextBlock Text="M" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="JAV Metadata Lite" FontSize="20" FontWeight="SemiBold" />
                        <Border Background="#193A2A" CornerRadius="8" Padding="9,3" Margin="12,1,0,0">
                            <TextBlock Text="单片模式" Foreground="#72E3A6" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="单片编辑，可选预览或直接保存，并可整理到番号文件夹" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="选择影片" Click="ChooseFile_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.35*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#0B1016" BorderBrush="#2A3544" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PosterImage" Stretch="Uniform" Margin="8" />
                            <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <TextBlock Text="＋" FontSize="38" Foreground="#5E7CA6" HorizontalAlignment="Center" />
                                <TextBlock Text="拖入一个影片文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="MP4 · MKV · AVI · WMV" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,7">
                        <TextBlock Text="Fanart 预览" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="FanartHintText" Text="等待完整封套" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="2" MinHeight="105" Background="#0B1016" BorderBrush="#2A3544" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="FanartImage" Stretch="Uniform" Margin="5" />
                            <TextBlock x:Name="FanartDropHint" Text="搜索后显示完整横版封套" Foreground="#607086" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FileNameText" Grid.Row="3" Text="尚未选择影片" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <TextBlock x:Name="FilePathText" Grid.Row="4" Text="影片将保持原位置" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelAltBrush}" CornerRadius="14,14,0,0" Padding="18,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="番号" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="SearchButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="搜索资料" Click="Search_Click" />
                            <Button Grid.Column="5" Content="网页导入" Click="Browser_Click" ToolTip="从 JAVLibrary 详情页读取" />
                            <ComboBox x:Name="SourceComboBox" Grid.Column="7" SelectedIndex="0" Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="自动补全（推荐）" Tag="auto" IsSelected="True" />
                                <ComboBoxItem Content="LibreDMM" Tag="libredmm" />
                                <ComboBoxItem Content="R18.dev" Tag="r18dev" />
                                <ComboBoxItem Content="JAVLibrary" Tag="javlibrary" />
                                <ComboBoxItem Content="仅手动填写" Tag="manual" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <Grid>
                                    <Label Content="标题" />
                                    <Button x:Name="TitleSourceText" Tag="Title" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="原始标题" />
                                    <Button x:Name="OriginalTitleSourceText" Tag="OriginalTitle" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding OriginalTitle, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="发行日期" />
                                    <Button x:Name="ReleaseDateSourceText" Tag="ReleaseDate" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ReleaseDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="时长（分钟）" />
                                    <Button x:Name="RuntimeSourceText" Tag="RuntimeMinutes" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding RuntimeMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="片商" />
                                    <Button x:Name="MakerSourceText" Tag="Maker" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Maker, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="导演" />
                                    <Button x:Name="DirectorSourceText" Tag="Director" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="标签 / 厂牌" />
                                    <Button x:Name="LabelSourceText" Tag="Label" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="系列" />
                                    <Button x:Name="SeriesSourceText" Tag="Series" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Series, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="演员（逗号分隔）" />
                                    <Button x:Name="ActorsSourceText" Tag="Actors" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ActorsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,13,0,0">
                                <Grid>
                                    <Label Content="类型（逗号分隔）" />
                                    <Button x:Name="GenresSourceText" Tag="Genres" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding GenresText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,13,0,6">
                                <Grid>
                                    <Label Content="简介" />
                                    <Button x:Name="PlotSourceText" Tag="Plot" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Plot, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="92" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" CornerRadius="0,0,14,14" Padding="18,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock Text="输出" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="WriteNfoCheckBox" Content="生成 NFO" IsChecked="True" />
                                    <CheckBox x:Name="DownloadPosterCheckBox" Content="高清海报" IsChecked="True" ToolTip="从高清原图自动裁出竖版 poster" />
                                    <CheckBox x:Name="DownloadFanartCheckBox" Content="横版 fanart" IsChecked="True" ToolTip="使用作品的完整横版封套" />
                                    <CheckBox x:Name="DownloadExtrafanartCheckBox" Content="保存全部剧照" IsChecked="False" ToolTip="把 Sample Images 保存到 extrafanart 文件夹" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="保存方式" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="DirectSaveOverwriteCheckBox" Content="直接保存并覆盖（跳过预览）" IsChecked="False" ToolTip="跳过保存前变更预览；已有 NFO 或图片将直接覆盖。影片文件永远不会被覆盖。" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="整理（默认关闭）" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="OrganizeFolderCheckBox" Content="整理到番号文件夹" IsChecked="False" ToolTip="在影片当前目录内创建标准番号子文件夹" />
                                    <CheckBox x:Name="RenameVideoCheckBox" Content="影片重命名为番号" IsChecked="False" ToolTip="只改变影片文件名，不改变扩展名" />
                                </WrapPanel>
                            </StackPanel>
                            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="保存" Click="Save_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111821" BorderBrush="#253040" BorderThickness="0,1,0,0" Padding="22,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#72E3A6" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备就绪，请选择或拖入一个影片" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="打开日志" Click="OpenLogs_Click" Padding="10,4" Margin="12,0" FontSize="11" FontWeight="Normal" Background="#1B2330" />
                <TextBlock Grid.Column="3" Text="v0.5.0-dev3 · 字段来源选择" Foreground="#607086" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
