                            <Button x:Name="SearchButton"
                                    Grid.Column="4"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Main.Search}"
                                    Click="Search_Click" />
                            <Button x:Name="BrowserImportButton"
                                    Grid.Column="6"
                                    Content="{DynamicResource Main.BrowserImportChoose}"
                                    Click="Browser_Click"
                                    ToolTip="{DynamicResource Main.BrowserImportChooseTooltip}"
                                    Padding="10,7"
                                    FontSize="12" />
                            <TextBlock x:Name="AutomaticSourceText"
                                       Grid.Column="8"
                                       Text="{DynamicResource Main.AutomaticSourceShort}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Grid x:Name="SourceSelectorHost"
                                  Grid.Column="10"
                                  MinWidth="120">
                                <ComboBox x:Name="SourceComboBox"
                                          MinWidth="100"
                                          Padding="7,7,53,7"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="0"
                                          Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="SourceSelection_Changed">
                                    <ComboBox.Resources>
                                        <!-- Only the closed selector is shortened; menu entries stay complete. -->
                                        <Style x:Key="ComboBoxSelectionContent" TargetType="ContentPresenter">
                                            <Setter Property="Content" Value="{DynamicResource SearchSourceSelectionLabel}" />
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="{DynamicResource Main.Source.LibreDmmRecommended}"
                                                  ToolTip="{DynamicResource Main.Source.LibreDmmTooltip}"
                                                  Tag="libredmm"
                                                  IsSelected="True" />
                                    <ComboBoxItem Content="R18.dev"
                                                  ToolTip="{DynamicResource Main.Source.R18Tooltip}"
                                                  Tag="r18dev" />
                                    <ComboBoxItem Content="{DynamicResource Main.Source.Custom}" Tag="custom" />
                                    <ComboBoxItem Content="{DynamicResource Main.Source.Manual}" Tag="manual" />
                                </ComboBox>
                                <Border x:Name="SourceProfileDivider"
                                        Width="1"
                                        Height="18"
                                        Margin="0,0,50,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="#52657D"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                                <Button x:Name="SourceProfileButton"
                                        Width="24"
                                        Height="26"
                                        MinWidth="24"
                                        MinHeight="26"
                                        Margin="0,0,23,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTip="{DynamicResource Main.Source.ConfigureTooltip}"
                                        AutomationProperties.Name="{DynamicResource Main.Source.EditRules}"
                                        Click="SourceProfile_Click"
                                        Visibility="Collapsed">
                                    <TextBlock Text="⚙"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="BatchSourceHint"
                                       Grid.Row="3"
                                       Grid.ColumnSpan="11"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="MetadataScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="VerticalOnly"
                                  Padding="16,15"
                                  local:PreciseScrollBehavior.Axis="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Title}" />
                                    <Button x:Name="TitleSourceText" Tag="Title" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.OriginalTitle}" />
                                    <Button x:Name="OriginalTitleSourceText" Tag="OriginalTitle" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding OriginalTitle, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.ReleaseDate}" />
                                    <Button x:Name="ReleaseDateSourceText" Tag="ReleaseDate" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ReleaseDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.RuntimeMinutes}" />
                                    <Button x:Name="RuntimeSourceText" Tag="RuntimeMinutes" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding RuntimeMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Maker}" />
                                    <Button x:Name="MakerSourceText" Tag="Maker" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Maker, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Director}" />
                                    <Button x:Name="DirectorSourceText" Tag="Director" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Label}" />
                                    <Button x:Name="LabelSourceText" Tag="Label" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Actors}" />
                                    <Button x:Name="ActorsSourceText" Tag="Actors" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ActorsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Rating}" ToolTip="{DynamicResource Field.RatingTooltip}" />
                                    <Button x:Name="RatingSourceText" Tag="Rating" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox x:Name="RatingTextBox"
                                         Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Field.RatingTooltip}" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Genres}" />
                                    <Button x:Name="GenresSourceText" Tag="Genres" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding GenresText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,6">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Plot}" />
                                    <Button x:Name="PlotSourceText" Tag="Plot" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Plot, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="92"
                                         VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.IsDeferredScrollingEnabled="False"
                                         local:PreciseScrollBehavior.Axis="Vertical" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="OutputPanel" Grid.Row="2" Background="{StaticResource PanelAltBrush}" CornerRadius="0,0,12,12" Padding="16,11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Button x:Name="SaveSettingsToggleButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        MinWidth="0"
                                        MinHeight="34"
                                        Padding="8,5"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ToggleSaveSettings_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="SaveSettingsChevronPath"
                                              Style="{StaticResource DisclosureChevronPath}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="SaveSettingsTitleText"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="SaveSettingsSummaryText"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="SaveSettingsOptionsPanel"
                                            Visibility="Collapsed"
                                            Margin="8,8,0,2">
                                    <WrapPanel>
                                        <TextBlock Text="{DynamicResource Main.Output}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <CheckBox x:Name="WriteNfoCheckBox" Content="{DynamicResource Main.WriteNfo}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" />
                                        <CheckBox x:Name="DownloadPosterCheckBox" Content="{DynamicResource Main.DownloadPoster}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadPosterTooltip}" />
                                         <CheckBox x:Name="DownloadFanartCheckBox" Content="{DynamicResource Main.DownloadFanart}" IsChecked="True" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadFanartTooltip}" />
                                         <CheckBox x:Name="DownloadExtrafanartCheckBox" Content="{DynamicResource Main.DownloadExtrafanart}" IsChecked="False" Checked="SaveConfiguration_Changed" Unchecked="SaveConfiguration_Changed" ToolTip="{DynamicResource Main.DownloadExtrafanartTooltip}" />
                                         <CheckBox x:Name="ReplaceLocalExtrafanartCheckBox"
                                                   Content="{DynamicResource Main.ReplaceLocalExtrafanart}"
                                                   IsChecked="False"
                                                   IsEnabled="{Binding IsChecked, ElementName=DownloadExtrafanartCheckBox}"
                                                   Checked="SaveConfiguration_Changed"
                                                   Unchecked="SaveConfiguration_Changed"
                                                   ToolTip="{DynamicResource Main.ReplaceLocalExtrafanartTooltip}" />
                                     </WrapPanel>
                                    <WrapPanel Margin="0,9,0,0">
                                        <TextBlock Text="{DynamicResource Main.NamingAndBehavior}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <CheckBox x:Name="IncludeIdInTitleCheckBox"
                                                  Content="{DynamicResource Main.IncludeIdInTitle}"
                                                  IsChecked="True"
                                                  IsEnabled="{Binding IsChecked, ElementName=WriteNfoCheckBox}"
                                                  Checked="IncludeIdInTitle_Changed"
                                                  Unchecked="IncludeIdInTitle_Changed"
                                                  ToolTip="{DynamicResource Main.IncludeIdInTitleTooltip}" />
                                        <CheckBox x:Name="RenameVideoCheckBox"
                                                  Content="{DynamicResource Main.RenameVideo}"
                                                  IsChecked="False"
                                                  Checked="TargetOption_Changed"
                                                  Unchecked="TargetOption_Changed"
                                                  ToolTip="{DynamicResource Main.RenameVideoTooltip}" />
                                        <CheckBox x:Name="SkipSavePreviewCheckBox"
                                                  Content="{DynamicResource Main.SkipSavePreview}"
                                                  IsChecked="False"
                                                  Checked="SavePreferencePresentation_Changed"
                                                  Unchecked="SavePreferencePresentation_Changed"
                                                  ToolTip="{DynamicResource Main.SkipSavePreviewTooltip}" />
                                        <CheckBox x:Name="RememberPreferencesCheckBox"
                                                  Content="{DynamicResource Main.RememberPreferences}"
                                                  IsChecked="False"
                                                  ToolTip="{DynamicResource Main.RememberUnifiedPreviewTooltip}" />
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Main.TargetLocation}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TargetModeComboBox"
                                              MinWidth="245"
                                              MaxWidth="360"
                                              SelectedIndex="0"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="TargetMode_Changed"
                                              Margin="0,0,18,0">
                                        <ComboBoxItem Content="{DynamicResource Main.Target.VideoDirectory}" Tag="VideoDirectory" IsSelected="True" />
                                        <ComboBoxItem Content="{DynamicResource Main.Target.SourceNumberFolder}" Tag="SourceNumberFolder" />
                                        <ComboBoxItem Content="{DynamicResource Main.Target.CustomRootNumberFolder}" Tag="CustomRootNumberFolder" />
                                    </ComboBox>
                                    <CheckBox x:Name="SkipCrossVolumeVerificationCheckBox"
                                              Content="{DynamicResource Main.SkipCrossVolumeVerification}"
                                              IsChecked="False"
                                              Visibility="Collapsed"
                                              Checked="TargetOption_Changed"
                                              Unchecked="TargetOption_Changed"
                                              ToolTip="{DynamicResource Main.SkipCrossVolumeVerificationTooltip}" />
                                </WrapPanel>
                                <Grid x:Name="CustomTargetPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Main.CustomRoot}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox x:Name="CustomRootTextBox"
                                             Grid.Column="2"
                                             Padding="8,5"
                                             FontSize="12"
                                             TextChanged="CustomRootText_Changed"
                                             LostFocus="CustomRootTextBox_LostFocus"
                                             KeyDown="CustomRootTextBox_KeyDown"
                                             ToolTip="{DynamicResource Main.CustomRootTooltip}" />
                                    <Button x:Name="RecentRootsButton"
                                            Grid.Column="4"
                                            Content="{DynamicResource Main.RecentRoots}"
                                            IsEnabled="False"
                                            Padding="12,6"
                                            Click="RecentRoots_Click"
                                            ToolTip="{DynamicResource Main.RecentRootsTooltip}" />
                                    <Button x:Name="ChooseTargetFolderButton"
                                            Grid.Column="6"
                                            Content="{DynamicResource Common.SelectFolder}"
                                            Padding="12,6"
                                            Click="ChooseTargetFolder_Click" />
                                </Grid>
                                <TextBlock x:Name="TargetPathHintText"
                                           Text="{DynamicResource Main.TargetHint}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="SingleSavePanel" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="SaveButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{DynamicResource Common.Save}"
                                        Click="Save_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="#253040" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#72E3A6" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{DynamicResource Main.StatusReadyInput}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="RetryFailedSourcesButton"
                        Grid.Column="2"
                        Content="{DynamicResource SearchFeedback.RetryFailed}"
                        Click="RetryFailedSources_Click"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Background="#1B2330"
                        Visibility="Collapsed" />
                <Button x:Name="CancelOperationButton"
                        Grid.Column="3"
                        Content="{DynamicResource Main.CancelOperation}"
                        Click="CancelOperation_Click"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Background="#4A2025"
                        BorderBrush="#85363D"
                        Visibility="Collapsed" />
                <Button Grid.Column="4" Content="{DynamicResource Common.OpenLogs}" Click="OpenLogs_Click" Padding="10,4" Margin="12,0" FontSize="11" FontWeight="Normal" Background="#1B2330" />
                <TextBlock x:Name="VersionText" Grid.Column="5" Foreground="#607086" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
