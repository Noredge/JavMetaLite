<Window x:Class="JavMetaLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JavMetaLite.App"
        xmlns:services="clr-namespace:JavMetaLite.Core.Services;assembly=JavMetaLite.Core"
        Title="{DynamicResource App.Title}"
        Icon="/JavMetaLite;component/Resources/Brand/JavMetaLite.ico"
        Width="1120" Height="790" MinWidth="930" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="BatchSourceWarningBrush" Color="#E9BC75" />
        <Style x:Key="SourceBadgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#6FA8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#233650" />
                                <Setter Property="Foreground" Value="#9BC1FF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="CandidateMenuRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Background="Transparent"
                                          CanContentScroll="False"
                                          IsDeferredScrollingEnabled="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="VerticalOnly"
                                          local:PreciseScrollBehavior.Axis="Vertical">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="540" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="CandidateBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CandidateBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D6FD2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#607086" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxSelectionContent" TargetType="ContentPresenter">
            <Setter Property="Content" Value="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7,28,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Style="{DynamicResource ComboBoxSelectionContent}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Width="8" Height="5" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Fill="#B8C5D6" Stretch="Fill"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        Background="#10161E"
                                        BorderBrush="#3A4A61"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  IsDeferredScrollingEnabled="False"
                                                  PanningMode="VerticalOnly"
                                                  local:PreciseScrollBehavior.Axis="Vertical">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceModeToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="#151D27"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#203D68" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="#253040" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="BrandIconImage"
                       Width="44" Height="44"
                       Margin="0,0,11,0"
                       Source="/JavMetaLite;component/Resources/Brand/JavMetaLite-64.png"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="JAV Metadata Lite" FontSize="19" FontWeight="SemiBold" />
                        <Border Background="#193A2A" CornerRadius="8" Padding="9,3" Margin="12,1,0,0">
                            <TextBlock Text="{DynamicResource Main.ModeBadge}" Foreground="#72E3A6" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText"
                               Text="{DynamicResource Main.Subtitle}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,3,16,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{DynamicResource Main.Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SingleModeButton"
                                 GroupName="WorkspaceMode"
                                 Style="{StaticResource WorkspaceModeToggle}"
                                 Content="{DynamicResource Main.Mode.Single}"
                                 IsChecked="True"
                                 Click="SingleMode_Click" />
                    <RadioButton x:Name="BatchModeButton"
                                 GroupName="WorkspaceMode"
                                 Style="{StaticResource WorkspaceModeToggle}"
                                 Content="{DynamicResource Main.Mode.Batch}"
                                 Margin="5,0,0,0"
                                 Click="BatchMode_Click" />
                </StackPanel>
                <ComboBox x:Name="LanguageComboBox"
                          Grid.Column="4"
                          Width="122"
                          Style="{StaticResource DarkComboBox}"
                          ToolTip="{DynamicResource Main.LanguageTooltip}"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                </ComboBox>
                <Button x:Name="ChooseVideoButton" Grid.Column="6" Content="{DynamicResource Main.ChooseVideo}" Click="ChooseFile_Click" VerticalAlignment="Center" />
                <Button x:Name="ScanFolderButton"
                        Grid.Column="8"
                        Content="{DynamicResource Main.ScanFolder}"
                        Click="ScanFolder_Click"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QueueColumn" Width="0" />
                <ColumnDefinition x:Name="QueueSpacerColumn" Width="0" />
                <ColumnDefinition x:Name="ArtworkColumn" Width="300" MinWidth="230" MaxWidth="390" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="QueueSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Visibility="Collapsed" />

            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border x:Name="QueuePanel"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,2,4,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Main.Queue}" FontWeight="SemiBold" />
                        <TextBlock x:Name="QueueCountText"
                                   Grid.Row="1"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="4,0,4,10">
                        <ComboBox x:Name="QueueFilterComboBox"
                                  SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="QueueFilter_Changed"
                                  ToolTip="{DynamicResource Main.QueueFilterTooltip}">
                            <ComboBoxItem Content="{DynamicResource Main.QueueFilter.All}" Tag="all" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource Main.QueueFilter.Pending}" Tag="pending" />
                            <ComboBoxItem Content="{DynamicResource Main.QueueFilter.Issues}" Tag="issues" />
                        </ComboBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousQueueButton"
                                    Content="{DynamicResource Main.PreviousMovie}"
                                    AutomationProperties.Name="{DynamicResource Main.PreviousQueueTooltip}"
                                    Padding="7,5"
                                    Click="PreviousQueue_Click"
                                    ToolTip="{DynamicResource Main.PreviousQueueTooltip}" />
                            <Button x:Name="NextQueueButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Main.NextMovie}"
                                    AutomationProperties.Name="{DynamicResource Main.NextQueueTooltip}"
                                    Padding="7,5"
                                    Click="NextQueue_Click"
                                    ToolTip="{DynamicResource Main.NextQueueTooltip}" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SelectAllQueueButton"
                                    Content="{DynamicResource Main.QueueSelectAll}"
                                    Click="SelectAllQueue_Click" />
                            <Button x:Name="SelectNoneQueueButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Main.QueueSelectNone}"
                                    Click="SelectNoneQueue_Click" />
                            <Button x:Name="RemoveSelectedQueueButton"
                                    Grid.Row="2"
                                    Padding="6,6"
                                    Content="{DynamicResource Main.QueueRemoveSelected}"
                                    Click="RemoveSelectedQueue_Click">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button x:Name="ClearQueueButton"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Content="{DynamicResource Main.QueueClear}"
                                    Click="ClearQueue_Click" />
                        </Grid>
                        <StackPanel Margin="0,7,0,0">
                            <Button x:Name="SearchQueueButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Main.SearchQueue}"
                                    Click="SearchQueue_Click" />
                            <Button x:Name="SaveSelectedButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Main.SaveSelected}"
                                    ToolTip="{DynamicResource Main.SaveSelectedTooltip}"
                                    Click="SaveSelected_Click"
                                    Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="MovieQueueList"
                             Grid.Row="2"
                             Background="{StaticResource InputBrush}"
                             BorderThickness="0"
                             Padding="0"
                             SelectionChanged="MovieQueueList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.PanningMode="VerticalOnly"
                             local:PreciseScrollBehavior.Axis="Vertical">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7"
                                        ClipToBounds="True">
                                    <ScrollViewer x:Name="QueueScrollViewer"
                                                  Background="{TemplateBinding Background}"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                  Focusable="False"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1E2A38" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#203D68" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding VideoPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="46"
                                            Background="#111923"
                                            BorderBrush="#334256"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="▣"
                                                   Foreground="#6FA8FF"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Metadata.Id}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource Queue.CurrentlyViewing}"
                                                       Foreground="#9BC1FF"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="5,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                             <CheckBox Grid.Column="2"
                                                       IsChecked="{Binding IsSelectedForBatch, Mode=TwoWay}"
                                                       ToolTip="{DynamicResource Queue.SelectedForBatch}"
                                                       Margin="6,0,0,0">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Style.Triggers>
                                                             <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searching}">
                                                                 <Setter Property="IsEnabled" Value="False" />
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.Saving}">
                                                                 <Setter Property="IsEnabled" Value="False" />
                                                             </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </Grid>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border x:Name="QueueReviewBadge" HorizontalAlignment="Left"
                                                Margin="0,5,0,0"
                                                Padding="7,2"
                                                CornerRadius="8"
                                                ToolTip="{Binding LastSearchError.Message}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#202B38" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsId}">
                                                            <Setter Property="Background" Value="#3A2C18" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searching}">
                                                            <Setter Property="Background" Value="#18355B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsReview}">
                                                            <Setter Property="Background" Value="#17382D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasPartialSourceFailure}" Value="True">
                                                            <Setter Property="Background" Value="#3A2C18" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasLowResolutionCover}" Value="True">
                                                            <Setter Property="Background" Value="#3A2C18" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchFailed}">
                                                            <Setter Property="Background" Value="#46242A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchCanceled}">
                                                            <Setter Property="Background" Value="#3A2C18" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Queue.Search.Searchable}" />
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsId}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.NeedsId}" />
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searching}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.Searching}" />
                                                            <Setter Property="Foreground" Value="#6FA8FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsReview}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.NeedsReview}" />
                                                            <Setter Property="Foreground" Value="#72E3A6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchFailed}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.Failed}" />
                                                            <Setter Property="Foreground" Value="#FF9DA6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.SearchCanceled}">
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.Canceled}" />
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasLowResolutionCover}" Value="True" />
                                                                <Condition Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.Searchable}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.NeedsReview}" />
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasLowResolutionCover}" Value="True" />
                                                                <Condition Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsReview}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SearchState}" Value="{x:Static services:MovieSearchState.NeedsReview}" />
                                                                <Condition Binding="{Binding HasPartialSourceFailure}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Search.Partial}" />
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                            <Setter Property="ToolTip" Value="{Binding FailedSourceNames}" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding HasRateLimitedSource}" Value="True">
                                                            <Setter Property="ToolTip" Value="{DynamicResource Error.SourceRateLimited}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock FontSize="11"
                                                   Margin="0,3,0,0"
                                                   ToolTip="{Binding LastSaveError.Message}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.Saving}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Saving}" />
                                                            <Setter Property="Foreground" Value="#6FA8FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.Completed}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Completed}" />
                                                            <Setter Property="Foreground" Value="#72E3A6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.SaveFailed}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Failed}" />
                                                            <Setter Property="Foreground" Value="#FF9DA6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.Conflict}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Conflict}" />
                                                            <Setter Property="Foreground" Value="#FF9DA6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SaveState}" Value="{x:Static services:MovieSaveState.SaveCanceled}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Text" Value="{DynamicResource Queue.Save.Canceled}" />
                                                            <Setter Property="Foreground" Value="#FFB74D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="ArtworkPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.35*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ArtworkSourceHeader" Margin="0,0,0,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
