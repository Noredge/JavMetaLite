<Window x:Class="JavMetaLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Icon="/JavMetaLite;component/Resources/Brand/JavMetaLite.ico"
        Width="1120" Height="790" MinWidth="930" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SourceBadgeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#6FA8FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0,0,6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BadgeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#233650" />
                                <Setter Property="Foreground" Value="#9BC1FF" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="#3A4A61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="CandidateMenuRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Background="Transparent"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CandidateMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="540" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="CandidateBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="CandidateBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D6FD2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#244B8F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#607086" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10161E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="{DynamicResource Ui.FontFamily}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="MaxDropDownHeight" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Margin="10,7,28,7"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <Path Width="8" Height="5" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Fill="#B8C5D6" Stretch="Fill"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        Background="#10161E"
                                        BorderBrush="#3A4A61"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="#253040" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="BrandIconImage"
                       Width="44" Height="44"
                       Margin="0,0,11,0"
                       Source="/JavMetaLite;component/Resources/Brand/JavMetaLite-64.png"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="JAV Metadata Lite" FontSize="19" FontWeight="SemiBold" />
                        <Border Background="#193A2A" CornerRadius="8" Padding="9,3" Margin="12,1,0,0">
                            <TextBlock Text="{DynamicResource Main.ModeBadge}" Foreground="#72E3A6" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText"
                               Text="{DynamicResource Main.Subtitle}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,3,16,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{DynamicResource Main.Subtitle}" />
                </StackPanel>
                <ComboBox x:Name="LanguageComboBox"
                          Grid.Column="2"
                          Width="122"
                          Style="{StaticResource DarkComboBox}"
                          ToolTip="{DynamicResource Main.LanguageTooltip}"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="日本語" Tag="ja" />
                </ComboBox>
                <Button x:Name="ChooseVideoButton" Grid.Column="4" Content="{DynamicResource Main.ChooseVideo}" Click="ChooseFile_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ArtworkPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.35*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ArtworkSourceHeader" Margin="0,0,0,7">
                        <TextBlock Text="{DynamicResource Main.ArtworkHeader}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ArtworkSourceButton"
                                Style="{StaticResource SourceBadgeButton}"
                                Padding="5,2" Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                Click="ArtworkSourceButton_Click" />
                    </Grid>
                    <Border x:Name="PosterPreviewBorder" Grid.Row="1" Background="#0B1016" BorderBrush="#2A3544" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PosterImage" Stretch="Uniform" Margin="8" />
                            <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <TextBlock Text="＋" FontSize="38" Foreground="#5E7CA6" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Main.DropInput}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="MP4 · MKV · AVI · WMV" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FanartHintText" Grid.Row="2" Text="" MinHeight="14" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,7" />
                    <Border x:Name="FanartPreviewBorder" Grid.Row="3" MinHeight="105" Background="#0B1016" BorderBrush="#2A3544" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="FanartImage" Stretch="Uniform" Margin="5" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FileNameText" Grid.Row="4" Text="{DynamicResource Main.NoVideo}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" />
                    <TextBlock x:Name="FilePathText" Grid.Row="5" Text="{DynamicResource Main.VideoStaysHere}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <Border x:Name="MetadataPanel" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SearchToolbar" Background="{StaticResource PanelAltBrush}" CornerRadius="12,12,0,0" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="162" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Main.MovieId}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="IdTextBox" Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="SearchButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Main.Search}" Click="Search_Click" />
                            <Button x:Name="BrowserImportButton" Grid.Column="5" Content="{DynamicResource Main.BrowserImport}" Click="Browser_Click" ToolTip="{DynamicResource Main.BrowserImportTooltip}" />
                            <ComboBox x:Name="SourceComboBox" Grid.Column="7" SelectedIndex="0" Style="{StaticResource DarkComboBox}">
                                <ComboBoxItem Content="{DynamicResource Main.Source.Auto}"
                                              ToolTip="{DynamicResource Main.Source.AutoTooltip}"
                                              Tag="auto"
                                              IsSelected="True" />
                                <ComboBoxItem Content="LibreDMM" Tag="libredmm" />
                                <ComboBoxItem Content="R18.dev" Tag="r18dev" />
                                <ComboBoxItem Content="JAVLibrary" Tag="javlibrary" />
                                <ComboBoxItem Content="{DynamicResource Main.Source.Manual}" Tag="manual" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Title}" />
                                    <Button x:Name="TitleSourceText" Tag="Title" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.OriginalTitle}" />
                                    <Button x:Name="OriginalTitleSourceText" Tag="OriginalTitle" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding OriginalTitle, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.ReleaseDate}" />
                                    <Button x:Name="ReleaseDateSourceText" Tag="ReleaseDate" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ReleaseDate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.RuntimeMinutes}" />
                                    <Button x:Name="RuntimeSourceText" Tag="RuntimeMinutes" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding RuntimeMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Maker}" />
                                    <Button x:Name="MakerSourceText" Tag="Maker" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Maker, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Director}" />
                                    <Button x:Name="DirectorSourceText" Tag="Director" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Director, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Label}" />
                                    <Button x:Name="LabelSourceText" Tag="Label" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Series}" />
                                    <Button x:Name="SeriesSourceText" Tag="Series" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Series, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Actors}" />
                                    <Button x:Name="ActorsSourceText" Tag="Actors" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding ActorsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,12,0,0">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Genres}" />
                                    <Button x:Name="GenresSourceText" Tag="Genres" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding GenresText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="42" />
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,6">
                                <Grid>
                                    <Label Content="{DynamicResource Field.Plot}" />
                                    <Button x:Name="PlotSourceText" Tag="Plot" Style="{StaticResource SourceBadgeButton}" Click="SourceBadge_Click" />
                                </Grid>
                                <TextBox Text="{Binding Plot, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="92" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="OutputPanel" Grid.Row="2" Background="{StaticResource PanelAltBrush}" CornerRadius="0,0,12,12" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <WrapPanel>
                                    <TextBlock Text="{DynamicResource Main.Output}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="WriteNfoCheckBox" Content="{DynamicResource Main.WriteNfo}" IsChecked="True" />
                                    <CheckBox x:Name="DownloadPosterCheckBox" Content="{DynamicResource Main.DownloadPoster}" IsChecked="True" ToolTip="{DynamicResource Main.DownloadPosterTooltip}" />
                                    <CheckBox x:Name="DownloadFanartCheckBox" Content="{DynamicResource Main.DownloadFanart}" IsChecked="True" ToolTip="{DynamicResource Main.DownloadFanartTooltip}" />
                                    <CheckBox x:Name="DownloadExtrafanartCheckBox" Content="{DynamicResource Main.DownloadExtrafanart}" IsChecked="False" ToolTip="{DynamicResource Main.DownloadExtrafanartTooltip}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Main.SaveMode}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="DirectSaveOverwriteCheckBox" Content="{DynamicResource Main.DirectOverwrite}" IsChecked="False" ToolTip="{DynamicResource Main.DirectOverwriteTooltip}" />
                                    <CheckBox x:Name="RenameVideoCheckBox"
                                              Content="{DynamicResource Main.RenameVideo}"
                                              IsChecked="False"
                                              Checked="TargetOption_Changed"
                                              Unchecked="TargetOption_Changed"
                                              ToolTip="{DynamicResource Main.RenameVideoTooltip}" />
                                    <CheckBox x:Name="RememberPreferencesCheckBox"
                                              Content="{DynamicResource Main.RememberPreferences}"
                                              IsChecked="False"
                                              ToolTip="{DynamicResource Main.RememberPreferencesTooltipVerification}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Main.TargetLocation}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TargetModeComboBox"
                                              Width="245"
                                              SelectedIndex="0"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="TargetMode_Changed"
                                              Margin="0,0,18,0">
                                        <ComboBoxItem Content="{DynamicResource Main.Target.VideoDirectory}" Tag="VideoDirectory" IsSelected="True" />
                                        <ComboBoxItem Content="{DynamicResource Main.Target.SourceNumberFolder}" Tag="SourceNumberFolder" />
                                        <ComboBoxItem Content="{DynamicResource Main.Target.CustomRootNumberFolder}" Tag="CustomRootNumberFolder" />
                                    </ComboBox>
                                    <CheckBox x:Name="SkipCrossVolumeVerificationCheckBox"
                                              Content="{DynamicResource Main.SkipCrossVolumeVerification}"
                                              IsChecked="False"
                                              Visibility="Collapsed"
                                              Checked="TargetOption_Changed"
                                              Unchecked="TargetOption_Changed"
                                              ToolTip="{DynamicResource Main.SkipCrossVolumeVerificationTooltip}" />
                                </WrapPanel>
                                <Grid x:Name="CustomTargetPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Main.CustomRoot}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox x:Name="CustomRootTextBox"
                                             Grid.Column="2"
                                             Padding="8,5"
                                             FontSize="12"
                                             TextChanged="CustomRootText_Changed"
                                             LostFocus="CustomRootTextBox_LostFocus"
                                             KeyDown="CustomRootTextBox_KeyDown"
                                             ToolTip="{DynamicResource Main.CustomRootTooltip}" />
                                    <Button x:Name="RecentRootsButton"
                                            Grid.Column="4"
                                            Content="{DynamicResource Main.RecentRoots}"
                                            IsEnabled="False"
                                            Padding="12,6"
                                            Click="RecentRoots_Click"
                                            ToolTip="{DynamicResource Main.RecentRootsTooltip}" />
                                    <Button x:Name="ChooseTargetFolderButton"
                                            Grid.Column="6"
                                            Content="{DynamicResource Common.SelectFolder}"
                                            Padding="12,6"
                                            Click="ChooseTargetFolder_Click" />
                                </Grid>
                                <TextBlock x:Name="TargetPathHintText"
                                           Text="{DynamicResource Main.TargetHint}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Common.Save}" Click="Save_Click" Margin="24,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="#253040" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#72E3A6" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{DynamicResource Main.StatusReadyInput}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="CancelOperationButton"
                        Grid.Column="2"
                        Content="{DynamicResource Main.CancelOperation}"
                        Click="CancelOperation_Click"
                        Padding="10,4"
                        Margin="12,0,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Background="#4A2025"
                        BorderBrush="#85363D"
                        Visibility="Collapsed" />
                <Button Grid.Column="3" Content="{DynamicResource Common.OpenLogs}" Click="OpenLogs_Click" Padding="10,4" Margin="12,0" FontSize="11" FontWeight="Normal" Background="#1B2330" />
                <TextBlock Grid.Column="4" Text="{DynamicResource Main.VersionPreview}" Foreground="#607086" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
