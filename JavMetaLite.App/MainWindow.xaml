                            <Image x:Name="PosterImage" Stretch="Uniform" Margin="8" />
                            <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <TextBlock Text="＋" FontSize="38" Foreground="#5E7CA6" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Main.DropInput}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="MP4 · MKV · AVI · WMV" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="PosterPreviewStatePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20"
                                        Visibility="Collapsed">
                                <TextBlock Text="◌" FontSize="26" Foreground="#5E7CA6" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PosterPreviewStateText"
                                           Text="{DynamicResource ArtworkPreview.Unavailable}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           Margin="0,5,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FanartRoleText"
                               Grid.Row="3"
                               Text="{DynamicResource Main.ArtworkFanartLabel}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,9,0,6" />
                    <Border x:Name="FanartPreviewBorder"
                            Grid.Row="4"
                            MinHeight="105"
                            Background="#0B1016"
                            BorderBrush="#2A3544"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Cursor="Hand"
                            ToolTip="{DynamicResource ArtworkViewer.OpenTooltip}"
                            MouseLeftButtonUp="FanartPreview_MouseLeftButtonUp">
                        <Grid>
                            <Image x:Name="FanartImage" Stretch="Uniform" Margin="5" />
                            <TextBlock x:Name="FanartPreviewStateText"
                                       Text="{DynamicResource ArtworkPreview.Unavailable}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FanartHintText" Grid.Row="5" Text="" MinHeight="14" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,5,0,0" />
                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileNameText"
                                   Text="{DynamicResource Main.NoVideo}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RemoveCurrentVideoButton"
                                Grid.Column="1"
                                Content="{DynamicResource Main.RemoveCurrentMovie}"
                                ToolTip="{DynamicResource Main.RemoveCurrentMovieTooltip}"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                Click="RemoveCurrentVideo_Click"
                                Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="FilePathText" Grid.Row="7" Text="{DynamicResource Main.VideoStaysHere}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <Border x:Name="MetadataPanel" Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SearchToolbar"
                            Background="{StaticResource PanelAltBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            SizeChanged="SearchToolbar_SizeChanged">
                        <Grid x:Name="SearchToolbarLayout" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MovieIdTextBlock"
                                       Grid.Column="0"
                                       Text="{DynamicResource Main.MovieId}"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="IdTextBox"
                                     Grid.Column="2"
                                     Width="100"
                                     HorizontalAlignment="Stretch"
                                     KeyDown="IdTextBox_KeyDown"
