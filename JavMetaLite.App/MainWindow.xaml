                                    Style="{StaticResource SourceBadgeButton}"
                                    Padding="5,2"
                                    Click="ArtworkSourceButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PosterRoleText"
                               Grid.Row="1"
                               Text="{DynamicResource Main.ArtworkPosterLabel}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,1,0,6" />
                    <Border x:Name="PosterPreviewBorder"
