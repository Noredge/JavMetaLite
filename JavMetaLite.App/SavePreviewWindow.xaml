<Window x:Class="JavMetaLite.App.SavePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Preview.Title}"
        Width="900" Height="650" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        ShowInTaskbar="False">
    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Preview.Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Preview.Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="PreviewPathPanel" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Preview.CurrentVideo}" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="SourcePathTextBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Padding="0" MinHeight="0" />
                <TextBlock Grid.Row="1" Text="{DynamicResource Preview.FinalVideo}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                <TextBox x:Name="TargetPathTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#72E3A6" TextWrapping="Wrap" Margin="0,10,0,0" Padding="0" MinHeight="0" />
            </Grid>
        </Border>

        <Border x:Name="ChangesPanel" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
            <ListView x:Name="ChangesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#111821" CornerRadius="8" Margin="3" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Action}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border x:Name="WarningPanel" Grid.Row="3" Background="#332615" BorderBrush="#79551D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="WarningText" Foreground="#FFD18A" TextWrapping="Wrap" />
                <CheckBox x:Name="OverwriteConfirmCheckBox" Content="{DynamicResource Preview.ConfirmOverwrite}" Margin="0,10,0,0" Checked="OverwriteConfirm_Changed" Unchecked="OverwriteConfirm_Changed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SafetyText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="{DynamicResource Preview.Safety}" TextWrapping="Wrap" Margin="0,0,18,0" />
            <StackPanel x:Name="FooterButtonsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common.Cancel}" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Common.ConfirmExecute}" Click="Confirm_Click" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
