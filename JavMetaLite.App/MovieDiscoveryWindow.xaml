<Window x:Class="JavMetaLite.App.MovieDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JavMetaLite.App"
        Title="{DynamicResource Discovery.Title}"
        Width="760" Height="560" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Discovery.Title}"
                   FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="{DynamicResource Discovery.Description}"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,14" />

        <Border Grid.Row="2"
                Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="InputPathsScrollViewer"
                              MaxHeight="64"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              IsDeferredScrollingEnabled="False"
                              PanningMode="VerticalOnly"
                              local:PreciseScrollBehavior.Axis="Vertical">
                    <TextBlock x:Name="RootPathText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </ScrollViewer>
                <CheckBox x:Name="IncludeSubdirectoriesCheckBox"
                          Grid.Row="1"
                          Content="{DynamicResource Discovery.IncludeSubdirectories}"
                          Margin="0,10,0,0"
                          IsChecked="True"
                          Checked="IncludeSubdirectories_Changed"
                          Unchecked="IncludeSubdirectories_Changed" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource InputBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="12,10,12,4">
                    <Button x:Name="SelectAllButton"
                            Content="{DynamicResource Discovery.SelectAll}"
                            Click="SelectAll_Click"
                            Padding="10,5" />
                    <Button x:Name="SelectNoneButton"
                            Content="{DynamicResource Discovery.SelectNone}"
                            Click="SelectNone_Click"
                            Padding="10,5"
                            Margin="8,0,0,0" />
                </StackPanel>
                <ListBox x:Name="MovieGroupsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         Padding="6"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.PanningMode="VerticalOnly"
                         local:PreciseScrollBehavior.Axis="Vertical">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding PrimaryPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}"
                                          VerticalAlignment="Center"
                                          Click="ItemSelection_Changed" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PrimaryPath}"
                                               Foreground="#7F93AA"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding StatusText}"
                                           Foreground="#6FA8FF"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="12,0,2,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="DiagnosticsText"
                       Foreground="#FFB74D"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxHeight="48"
                       Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" IsCancel="True" />
            <Button x:Name="AddButton"
                    Style="{StaticResource PrimaryButton}"
                    Content="{DynamicResource Discovery.AddFound}"
                    Click="Add_Click"
                    Margin="10,0,0,0"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
